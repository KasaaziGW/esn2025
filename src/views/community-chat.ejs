        scrollToBottom();
    }
        
        // Handle Enter key press
        function handleKeyPress(event) {
            if (event.key === 'Enter') {
                sendMessage();
            }
        }
        
    // Send message
    function sendMessage() {
        const input = $('#messageInput');
        const content = input.val().trim();
        
        
        if (!content) {
            // console.log('No content to send');
            input.focus();
            return;
        }
        
        // Get the community ID to use for Socket.IO
        let communityId = currentCommunityId || userCommunityId;
        
        if (!communityId) {
            // console.log('No community ID available, trying to load from API...');
            loadCommunityInfo();
            setTimeout(() => {
                if (currentCommunityId) {
                    sendMessage();
                } else {
                    alert('Community ID not available. Please refresh the page.');
                }
            }, 1000);
            return;
        }
        
        // console.log('Using community ID for message:', communityId);
        
        if (socket && socket.connected) {
            // console.log('Sending via Socket.IO');
            
            socket.emit('communityMessage', {
                communityId: communityId,
                content: content,
                type: 'text'
            });
            
            // console.log('Message emitted via Socket.IO');
            
            // Clear input after sending
            input.val('');
            input.css('height', 'auto');
        } else {
            // console.log('Socket not connected, using REST API');
            
            // Try to create community chat if it doesn't exist
            if (!communityChatId) {
                createCommunityChat(communityId);
                setTimeout(() => {
                    if (communityChatId) {
                        sendMessage();
                    } else {
                        alert('Community chat not available. Please refresh the page.');
                    }
                }, 1000);
                return;
            }
            
            // Fallback to REST API
            $.ajax({
                url: `/chats/${communityChatId}/messages`,
                method: 'POST',
                data: { content: content, type: 'text' },
                success: function(response) {
                    // console.log('Message sent via REST:', response);
                    if (response.data && response.data.message) {
                        displayMessage(response.data.message);
                        scrollToBottom();
                    }
                    // Clear input after sending
                    input.val('');
                    input.css('height', 'auto');
                },
                error: function(xhr) {
                    console.error('Failed to send message:', xhr);
                    alert('Failed to send message. Please try again.');
                }
            });
        }
    }
    
    // Handle key press
    function handleKeyPress(event) {
        if (event.key === 'Enter') {
                event.preventDefault();
            sendMessage();
        }
    }
    
    // Trigger file upload
    function triggerFileUpload() {
        $('#fileUpload').click();
    }
    
    // Handle file upload
    $('#fileUpload').on('change', function(e) {
        const file = e.target.files[0];
            if (!file || !currentChatId) return;
        
        const formData = new FormData();
        formData.append('file', file);
        
        $.ajax({
                url: `/chats/${currentChatId}/messages`,
            method: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(response) {
                // console.log('File sent:', response);
                    if (response.data && response.data.message) {
                        displayMessage(response.data.message);
                        scrollToBottom();
                    }
                $('#fileUpload').val('');
            },
            error: function(xhr) {
                console.error('Failed to send file:', xhr);
                alert('Failed to send file');
            }
        });
    });
    
        // Update chat list item
        function updateChatListItem(chatId, lastMessage, lastMessageTime) {
            const chatLink = $(`a[onclick*="${chatId}"]`);
            if (chatLink.length) {
                chatLink.find('.flex-grow-1 small').text(lastMessage);
            }
    }
    
    // Scroll to bottom
    function scrollToBottom() {
        const container = $('.chat-content-body');
        container.scrollTop(container[0].scrollHeight);
    }
    
    // Utility functions
    function formatTime(dateString) {
        const date = new Date(dateString);
        const now = new Date();
        const diff = now - date;
        
        if (diff < 60000) return 'Just now';
        if (diff < 3600000) return `${Math.floor(diff / 60000)}m ago`;
        if (diff < 86400000) return `${Math.floor(diff / 3600000)}h ago`;
        return date.toLocaleDateString();
    }
        
        // Format time in 12-hour format (07:17 PM)
        function formatTime12Hour(date) {
            const messageDate = new Date(date);
            return messageDate.toLocaleTimeString('en-US', {
                hour: '2-digit',
                minute: '2-digit',
                hour12: true
            });
    }
    
    function formatDate(dateString) {
        const date = new Date(dateString);
        const today = new Date();
        const yesterday = new Date(today);
        yesterday.setDate(yesterday.getDate() - 1);
        
        if (date.toDateString() === today.toDateString()) {
            return 'Today';
        } else if (date.toDateString() === yesterday.toDateString()) {
            return 'Yesterday';
        } else {
            return date.toLocaleDateString();
        }
    }
    
    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
    
        // View user profile
        function viewUserProfile(userId, userName) {
            // Open profile in a new tab or modal
            window.open(`/profile/${userId}`, '_blank');
        }
        
        // Update user online/offline status
        function updateUserStatus(userId, isOnline) {
            // Update status in chat list
            const userElements = $(`.media[data-user-id="${userId}"]`);
            userElements.find('.avatar').removeClass('avatar-online avatar-offline')
                .addClass(isOnline ? 'avatar-online' : 'avatar-offline');
            
            // Update status in community members list
            const memberElements = $(`.media[data-member-id="${userId}"]`);
            memberElements.find('.avatar').removeClass('avatar-online avatar-offline')
                .addClass(isOnline ? 'avatar-online' : 'avatar-offline');
            
            // Update status in chat header if current chat user
            if (currentChatUser && currentChatUser.id === userId) {
                const headerAvatar = $('#chatTitle .avatar');
                headerAvatar.removeClass('avatar-online avatar-offline')
                    .addClass(isOnline ? 'avatar-online' : 'avatar-offline');
            }
        }
        
        // Save active chat to localStorage
        function saveActiveChat(chatId, userName, userId) {
            const activeChat = {
                chatId: chatId,
                userName: userName,
                userId: userId,
                timestamp: Date.now()
            };
            localStorage.setItem('activeChat', JSON.stringify(activeChat));
        }
        
        // Restore last active chat from localStorage
        function restoreLastActiveChat() {
            try {
                const savedChat = localStorage.getItem('activeChat');
                if (savedChat) {
                    const activeChat = JSON.parse(savedChat);
                    // Check if the chat is not too old (within 24 hours)
                    const chatAge = Date.now() - activeChat.timestamp;
                    if (chatAge < 24 * 60 * 60 * 1000) { // 24 hours
                        // console.log('Restoring last active chat:', activeChat);
                        openChat(activeChat.chatId, activeChat.userName, activeChat.userId);
                    } else {
                        // Clear old chat data
                        localStorage.removeItem('activeChat');
                    }
                }
            } catch (error) {
                console.error('Error restoring last active chat:', error);
                localStorage.removeItem('activeChat');
            }
        }
        
        // Show welcome message when no chat is selected
        function showWelcomeMessage() {
            $('#chatMessages').html(`
                <div class="text-center text-muted pd-y-40">
                    <i data-feather="message-square" class="wd-48 mg-b-10"></i>
                    <h6>Welcome to Private Chat</h6>
                    <p class="tx-color-03">Select a user from the sidebar to start a conversation</p>
                </div>
            `);
            feather.replace();
        }
        
        // Clear current chat and reset state
        function clearCurrentChat() {
            currentChatId = null;
            currentChatUser = null;
            $('#chatMessages').empty();
            $('#chatTitle').addClass('d-none');
            $('#chatNav').addClass('d-none');
            $('#chatFooter').addClass('d-none');
            $('.media').removeClass('active');
            localStorage.removeItem('activeChat');
            showWelcomeMessage();
        }
    </script>

