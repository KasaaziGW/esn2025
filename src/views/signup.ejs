<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Required meta tags -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">

    <!-- Meta -->
    <meta name="description" content="Join Emergency Social Network - Stay Connected, Stay Safe">
    <meta name="author" content="Ainedembe Denis, Namusoke Olivia">

    <!-- Favicon -->
    <link rel="shortcut icon" type="image/x-icon" href="/assets/img/esn-logo.png">

    <title>Sign Up - Emergency Social Network</title>

    <!-- vendor css -->
    <link href="/lib/@fortawesome/fontawesome-free/css/all.min.css" rel="stylesheet">

    <!-- DashForge CSS -->
    <link rel="stylesheet" href="/assets/css/dashforge.css?v=<%= Date.now() %>">
    <link rel="stylesheet" href="/assets/css/dashforge.auth.css">
    
    <!-- Custom Styles for Multi-Step Form -->
    <style>
        .form-step {
            display: none;
        }
        
        .form-step.active {
            display: block;
        }
        
        .step-indicator {
            text-align: center;
            flex: 1;
            position: relative;
        }
        
        .step-indicator:not(:last-child)::after {
            content: '';
            position: absolute;
            top: 15px;
            left: 60%;
            width: 80%;
            height: 2px;
            background: #e9ecef;
            z-index: 1;
        }
        
        .step-indicator.active:not(:last-child)::after {
            background: #007bff;
        }
        
        .step-indicator.completed:not(:last-child)::after {
            background: #28a745;
        }
        
        .step-number {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #e9ecef;
            color: #6c757d;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 8px;
            font-weight: 600;
            font-size: 14px;
            position: relative;
            z-index: 2;
            transition: all 0.3s ease;
        }
        
        .step-indicator.active .step-number {
            background: #007bff;
            color: white;
        }
        
        .step-indicator.completed .step-number {
            background: #28a745;
            color: white;
        }
        
        .step-label {
            font-size: 12px;
            color: #6c757d;
            font-weight: 500;
        }
        
        .step-indicator.active .step-label {
            color: #007bff;
            font-weight: 600;
        }
        
        .step-indicator.completed .step-label {
            color: #28a745;
            font-weight: 600;
        }
        
        .progress {
            height: 6px;
            background: #e9ecef;
        }
        
        .progress-bar {
            background: linear-gradient(90deg, #007bff 0%, #28a745 100%);
            transition: width 0.5s ease;
        }
        
        @media (max-width: 768px) {
            .step-indicator {
                flex: none;
                min-width: 60px;
            }
            
            .step-indicator:not(:last-child)::after {
                display: none;
            }
            
            .step-label {
                font-size: 10px;
            }
        }
    </style>
</head>
<body>

    <header class="navbar navbar-header navbar-header-fixed">
        <a href="#" id="mainMenuOpen" class="burger-menu"><i data-feather="menu"></i></a>
        <div class="navbar-brand">
            <a href="/" class="df-logo">E<span>S</span>N</a>
        </div><!-- navbar-brand -->
        <div id="navbarMenu" class="navbar-menu-wrapper">
            <div class="navbar-menu-header">
                <a href="/" class="df-logo">Emergency<span>Social</span> Network</a>
                <a id="mainMenuClose" href="#"><i data-feather="x"></i></a>
            </div><!-- navbar-menu-header -->
            <ul class="nav navbar-menu">
                <li class="nav-label pd-l-20 pd-lg-l-25 d-lg-none">Main Navigation</li>
                <li class="nav-item">
                    <a href="/" class="nav-link"><i data-feather="home"></i> Home</a>
                </li>
                <li class="nav-item">
                    <a href="/api-docs" target="_blank" class="nav-link"><i data-feather="book"></i> API Docs</a>
                </li>
                <li class="nav-item">
                    <a href="#" class="nav-link"><i data-feather="info"></i> About</a>
                </li>
            </ul>
        </div><!-- navbar-menu-wrapper -->
        <div class="navbar-right">
            <a href="/login" class="btn btn-primary btn-sm">Login</a>
            <a href="/register" class="btn btn-outline-primary btn-sm">Register</a>
        </div><!-- navbar-right -->
    </header><!-- navbar -->

    <div class="content content-fixed content-auth">
        <div class="container">
            <div class="media align-items-stretch justify-content-center ht-100p">
                <div class="sign-wrapper mg-lg-r-50 mg-xl-r-60">
                    <div class="pd-t-20 wd-100p">
                        <h4 class="tx-color-01 mg-b-5">Create New Account</h4>

                        <!-- Alert Messages -->
                        <div id="alertContainer"></div>

                        <!-- Progress Steps -->
                        <div class="progress mg-b-30">
                            <div class="progress-bar" id="progressBar" role="progressbar" style="width: 33.33%" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        
                        <div class="d-flex justify-content-between mg-b-30">
                            <div class="step-indicator active" data-step="1">
                                <div class="step-number">1</div>
                                <div class="step-label">Personal Info</div>
                            </div>
                            <div class="step-indicator" data-step="2">
                                <div class="step-number">2</div>
                                <div class="step-label">Account Details</div>
                            </div>
                            <div class="step-indicator" data-step="3">
                                <div class="step-number">3</div>
                                <div class="step-label">Security</div>
                            </div>
                        </div>

                        <form id="signupForm" method="POST" action="/auth/register">
                            <!-- Step 1: Personal Information -->
                            <div class="form-step active" id="step1">
                                <h6 class="tx-16 tx-semibold mg-b-20">Personal Information</h6>
                                
                                <!-- First Name Field -->
                                <div class="form-group">
                                    <label>Firstname *</label>
                                    <input type="text" class="form-control" id="firstName" name="firstName" placeholder="Enter your firstname" required="required" autocomplete="off">
                                </div>

                                <!-- Last Name Field -->
                                <div class="form-group">
                                    <label>Lastname *</label>
                                    <input type="text" class="form-control" id="lastName" name="lastName" placeholder="Enter your lastname" required="required" autocomplete="off">
                                </div>

                                <!-- Display Name Field (auto-populated) -->
                                <div class="form-group">
                                    <label>Display Name</label>
                                    <input type="text" class="form-control" id="displayName" name="displayName" placeholder="How others will see you">
                                    <small class="form-text text-muted">Auto-suggested from first and last name</small>
                                </div>
                                
                                <div class="d-flex justify-content-end mg-t-20">
                                    <button type="button" class="btn btn-brand-02" id="nextStep1">Next</button>
                                </div>
                            </div>

                            <!-- Step 2: Account Details -->
                            <div class="form-step" id="step2">
                                <h6 class="tx-16 tx-semibold mg-b-20">Account Details</h6>
                                
                                <!-- Username Field -->
                                <div class="form-group">
                                    <label>Username *</label>
                                    <input type="text" class="form-control" id="username" name="username" placeholder="Enter your username" required="required" autocomplete="off">
                                    <small class="form-text text-muted">3-30 characters, letters, numbers, and underscores only</small>
                                </div>

                                <!-- Email or Phone Field -->
                                <div class="form-group">
                                    <label id="identifierLabel">Email address or Phone *</label>
                                    <input type="text" class="form-control" id="identifier" name="identifier" placeholder="Enter email or phone" required="required" autocomplete="off">
                                    <small class="form-text text-muted" id="identifierHelp">Use email format (e.g., user@xyx.com) or phone with country code (e.g., +1234567890)</small>
                                </div>
                                
                                <div class="d-flex justify-content-between mg-t-20">
                                    <button type="button" class="btn btn-outline-secondary" id="prevStep2">Previous</button>
                                    <button type="button" class="btn btn-brand-02" id="nextStep2">Next</button>
                                </div>
                            </div>

                            <!-- Step 3: Security -->
                            <div class="form-step" id="step3">
                                <h6 class="tx-16 tx-semibold mg-b-20">Create Password</h6>
                                
                                <!-- Password Field -->
                                <div class="form-group">
                                    <div class="d-flex justify-content-between mg-b-5">
                                        <label class="mg-b-0-f">Password *</label>
                                    </div>
                                    <input type="password" class="form-control" id="password" name="password" placeholder="Enter your password" required autocomplete="off">
                                    <small class="form-text text-muted">Minimum 6 characters</small>
                                </div>
                                
                                <!-- Confirm Password Field -->
                                <div class="form-group">
                                    <div class="d-flex justify-content-between mg-b-5">
                                        <label class="mg-b-0-f">Confirm Password *</label>
                                    </div>
                                    <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" placeholder="Confirm your password" required autocomplete="off">
                                </div>
                                
                                <div class="form-group tx-12 mg-t-20">
                                    By clicking <strong>Create an account</strong> below, you agree to our terms of service and privacy statement.
                                </div><!-- form-group -->
                                
                                <div class="d-flex justify-content-between mg-t-20">
                                    <button type="button" class="btn btn-outline-secondary" id="prevStep3">Previous</button>
                                    <button type="submit" class="btn btn-brand-02" id="submitBtn">Create Account</button>
                                </div>
                            </div>
                            
                            <div class="tx-13 mg-t-20 tx-center">Already have an account? <a href="/login">Sign In</a></div>
                        </form>
                    </div>
                </div><!-- sign-wrapper -->

                <div class="media-body pd-y-30 pd-lg-x-50 pd-xl-x-60 align-items-center d-none d-lg-flex pos-relative">
                    <div class="mx-lg-wd-500 mx-xl-wd-550">
                        <img src="/assets/img/esn.png" class="img-fluid" alt="">
                    </div>
                    <div class="pos-absolute b-0 r-0 tx-12">
                        Emergency Social Network - Stay Connected, Stay Safe
                    </div>
                </div><!-- media-body -->
            </div><!-- media -->
        </div><!-- container -->
    </div><!-- content -->

    <!-- Footer -->
    <footer class="footer">
        <div>
            <span>&copy; 2024 Emergency Social Network. </span>
            <span>Made with <i data-feather="heart" class="tx-danger" style="width: 16px; height: 16px;"></i> for community safety</span>
        </div>
        <div>
            <nav class="nav">
                <a href="/api-docs" target="_blank" class="nav-link">API Documentation</a>
                <a href="#" target="_blank" class="nav-link">Privacy Policy</a>
                <a href="#" target="_blank" class="nav-link">Terms of Service</a>
                <a href="#" target="_blank" class="nav-link">Get Help</a>
            </nav>
        </div>
    </footer>

    <!-- JavaScript -->
    <script src="/lib/jquery/jquery.min.js"></script>
    <script src="/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/lib/feather-icons/feather.min.js"></script>
    <!-- libphonenumber-js for phone validation -->
    <script src="https://unpkg.com/libphonenumber-js@1.12.23/bundle/libphonenumber-js.min.js"></script>
    
    <!-- Signup form logic -->
    <script src="/assets/component-logic-js/signup.js"></script>
</body>
</html>
