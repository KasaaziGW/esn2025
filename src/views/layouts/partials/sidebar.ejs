<aside class="aside aside-fixed">
    <div class="aside-header">
        <a href="/dashboard" class="aside-logo">
            <img src="/assets/img/esn.png" alt="ESN" class="wd-30">
            <span class="brand-text">ESN</span>
        </a>
        <a href="#" class="aside-menu-link">
            <i data-feather="menu"></i>
            <i data-feather="x"></i>
        </a>
    </div>
    <div class="aside-body">
        <div class="aside-loggedin">
            <div class="d-flex align-items-center justify-content-start">
                <a href="#" class="avatar"><img src="<%= user.avatarUrl || '/assets/img/avatar.webp' %>" class="rounded-circle" style="border: 2px solid #007bff;" alt="<%= user.displayName || user.username %>"></a>
                <div class="aside-alert-link">
                    <a href="#" class="new" data-bs-toggle="tooltip" title="You have 2 unread messages"><i data-feather="message-square"></i></a>
                    <a href="#" class="new" data-bs-toggle="tooltip" title="You have 4 new notifications"><i data-feather="bell"></i></a>
                    <a href="/logout" data-bs-toggle="tooltip" title="Sign out"><i data-feather="log-out"></i></a>
                </div>
            </div>
            <div class="aside-loggedin-user">
                <a href="#loggedinMenu" class="d-flex align-items-center justify-content-between mg-b-2" data-bs-toggle="collapse">
                    <h6 class="tx-semibold mg-b-0"><%= user.displayName || user.username %></h6>
                    <i data-feather="chevron-down"></i>
                </a>
                <p class="tx-color-03 tx-12 mg-b-0"><%= user.role.charAt(0).toUpperCase() + user.role.slice(1) %></p>
            </div>
            <div class="collapse" id="loggedinMenu">
                <ul class="nav nav-aside mg-b-0">
                    <li class="nav-item"><a href="/users/profile" class="nav-link"><i data-feather="user"></i> <span>View Profile</span></a></li>
                    <li class="nav-item"><a href="/logout" class="nav-link"><i data-feather="log-out"></i> <span>Sign Out</span></a></li>
                </ul>
            </div>
        </div><!-- aside-loggedin -->
        <ul class="nav nav-aside">
            <li class="nav-label">Dashboard</li>
            <li class="nav-item <%= activePage === 'dashboard' ? 'active' : '' %>"><a href="/dashboard" class="nav-link"><i data-feather="home"></i> <span>Dashboard</span></a></li>
            
            <li class="nav-label mg-t-25">Emergency Features</li>
            <li class="nav-item <%= activePage === 'alerts' ? 'active' : '' %>">
                <a href="<%= hasJoinedCommunity ? '/alerts' : '#' %>" 
                   class="nav-link <%= hasJoinedCommunity ? '' : 'text-muted' %>" 
                   <%= hasJoinedCommunity ? '' : 'onclick="event.preventDefault(); alert(\'Please join a community first to access Emergency Alerts.\'); return false;"' %>>
                    <i data-feather="alert-triangle"></i> <span>Emergency Alerts</span>
                </a>
            </li>
            <li class="nav-item <%= activePage === 'emergency' ? 'active' : '' %>">
                <a href="#" 
                   class="nav-link <%= hasJoinedCommunity ? '' : 'text-muted' %>" 
                   <%= hasJoinedCommunity ? '' : 'onclick="event.preventDefault(); alert(\'Please join a community first to access Emergency Contacts.\'); return false;"' %>>
                    <i data-feather="phone"></i> <span><strike>Emergency Contacts</strike></span>
                </a>
            </li>
            <li class="nav-item <%= activePage === 'status' ? 'active' : '' %>">
                <a href="#" 
                   class="nav-link <%= hasJoinedCommunity ? '' : 'text-muted' %>" 
                   <%= hasJoinedCommunity ? '' : 'onclick="event.preventDefault(); alert(\'Please join a community first to access Share Status.\'); return false;"' %>>
                    <i data-feather="activity"></i> <span><strike>Share Status</strike></span>
                </a>
            </li>
            
            <li class="nav-label mg-t-25">Communication</li>
            <% if (user.role !== 'admin') { %>
            <li class="nav-item <%= activePage === 'communities' ? 'active' : '' %>">
                <a href="<%= (user.region && user.district) ? '/communities' : '#' %>" 
                   class="nav-link profile-required-link" 
                   data-required="true" 
                   data-message="Set your region and district to access Communities"
                   data-redirect="/users/profile">
                    <i data-feather="users"></i> <span>Communities</span>
                </a>
            </li>
            <% } %>
            <li class="nav-item <%= activePage === 'public-chat' ? 'active' : '' %>">
                <a href="<%= hasJoinedCommunity ? '/public-chat' : '#' %>" 
                   class="nav-link <%= hasJoinedCommunity ? '' : 'text-muted' %>" 
                   <%= hasJoinedCommunity ? '' : 'onclick="event.preventDefault(); alert(\'Please join a community first to access Public Chat.\'); return false;"' %>>
                   <i data-feather="users"></i> <span>Public Chat</span>
                </a>
            </li>
            <li class="nav-item <%= activePage === 'chat' ? 'active' : '' %>">
                <a href="<%= hasJoinedCommunity ? '/chat' : '#' %>" 
                   class="nav-link <%= hasJoinedCommunity ? '' : 'text-muted' %>" 
                   <%= hasJoinedCommunity ? '' : 'onclick="event.preventDefault(); alert(\'Please join a community first to access Private Chat.\'); return false;"' %>>
                    <i data-feather="message-circle"></i> <span>Private Chat</span>
                </a>
            </li>
            <li class="nav-item <%= activePage === 'announcements' ? 'active' : '' %>">
                <a href="<%= hasJoinedCommunity ? '/announcements' : '#' %>" 
                   class="nav-link <%= hasJoinedCommunity ? '' : 'text-muted' %>" 
                   <%= hasJoinedCommunity ? '' : 'onclick="event.preventDefault(); alert(\'Please join a community first to access Announcements.\'); return false;"' %>>
                   <i data-feather="message-square"></i> <span>Announcements</span>
                </a>
            </li>
            
            <% if (user.role === 'coordinator') { %>
            <li class="nav-label mg-t-25">Coordination</li>
            <li class="nav-item <%= activePage === 'coordinator-announcements' ? 'active' : '' %>">
                <a href="/coordinator/announcements" class="nav-link">
                    <i data-feather="message-square"></i><span>Manage Announcements</span>
                </a>
            </li>
            <% } %>
            
            <% if (user.role === 'admin') { %>
            <li class="nav-label mg-t-25">Administration</li>
            <li class="nav-item <%= activePage === 'admin-users' ? 'active' : '' %>"><a href="/users/admin" class="nav-link"><i data-feather="user-check"></i> <span>User Management</span></a></li>
            <li class="nav-item <%= activePage === 'admin-communities' ? 'active' : '' %>"><a href="/admin/communities" class="nav-link"><i data-feather="users"></i> <span>Communities</span></a></li>
            <li class="nav-item <%= activePage === 'admin-coordinator-requests' ? 'active' : '' %>"><a href="/admin/coordinator-requests" class="nav-link"><i data-feather="user-plus"></i> <span>Coordinator Requests</span></a></li>
            <li class="nav-item <%= activePage === 'logs' ? 'active' : '' %>"><a href="/admin/logs" class="nav-link"><i data-feather="file-text"></i> <span>System Logs</span></a></li>
            <li class="nav-item <%= activePage === 'settings' ? 'active' : '' %>"><a href="#" class="nav-link"><i data-feather="settings"></i> <span>System Settings</span></a></li>
            <% } %>

        </ul>
    </div>
</aside>
