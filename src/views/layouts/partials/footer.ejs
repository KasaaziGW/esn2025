<script>
// Ensure SweetAlert2 is loaded
if (typeof Swal === 'undefined') {
    console.error('SweetAlert2 failed to load from CDN');
    // Fallback: try loading from another CDN
    const script = document.createElement('script');
    script.src = 'https://unpkg.com/sweetalert2@11';
    script.onload = function() {
        console.log('SweetAlert2 loaded from fallback CDN');
    };
    script.onerror = function() {
        console.error('SweetAlert2 fallback CDN also failed');
    };
    document.head.appendChild(script);
} else {
    console.log('SweetAlert2 loaded successfully from primary CDN');
}
</script>
