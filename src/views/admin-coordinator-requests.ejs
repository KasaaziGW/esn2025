<%- include('layouts/partials/top-files') %>
<%- include('layouts/partials/sidebar', { user: user, activePage: 'admin-coordinator-requests' }) %>
<%- include('layouts/partials/header') %>

<div class="container-fluid">
  <div class="row">
    <div class="col-lg-12">
      <div class="breadcrumb-content">
        <div class="breadcrumb-content-left">
          <h4 class="breadcrumb-title">Coordinator Requests</h4>
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
              <li class="breadcrumb-item"><a href="/dashboard">Dashboard</a></li>
              <li class="breadcrumb-item active" aria-current="page">Coordinator Requests</li>
            </ol>
          </nav>
        </div>
      </div>
    </div>
  </div>
  
  <div class="row">
    <div class="col-lg-12">
      <!-- Filter and Search -->
      <div class="card mg-b-20">
        <div class="card-body">
          <div class="row">
            <div class="col-md-4">
              <div class="form-group">
                <label for="statusFilter">Filter by Status</label>
                <select class="form-control" id="statusFilter">
                  <option value="">All Requests</option>
                  <option value="pending">Pending</option>
                  <option value="approved">Approved</option>
                  <option value="rejected">Rejected</option>
                </select>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-group">
                <label for="communityFilter">Filter by Community</label>
                <select class="form-control" id="communityFilter">
                  <option value="">All Communities</option>
                </select>
              </div>
            </div>
            <div class="col-md-4">
              <div class="form-group">
                <label for="searchInput">Search</label>
                <input type="text" class="form-control" id="searchInput" placeholder="Search by user name or organization...">
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Requests List -->
      <div class="card">
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>User</th>
                  <th>Community</th>
                  <th>Position</th>
                  <th>Organization</th>
                  <th>Status</th>
                  <th>Requested</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="requestsTableBody">
                <tr>
                  <td colspan="7" class="text-center">
                    <div class="spinner-border" role="status">
                      <span class="sr-only">Loading...</span>
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Review Request Modal -->
<div class="modal fade" id="reviewRequestModal" tabindex="-1" role="dialog" aria-labelledby="reviewRequestModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="reviewRequestModalLabel">
          <i data-feather="user-check" class="wd-16 mg-r-5"></i>
          Review Coordinator Request
        </h5>
        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <div class="modal-body" id="reviewRequestContent">
        <!-- Content will be loaded dynamically -->
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        <button type="button" class="btn btn-danger" id="rejectBtn">
          <i data-feather="x-circle" class="wd-12 mg-r-5"></i>
          Reject
        </button>
        <button type="button" class="btn btn-success" id="approveBtn">
          <i data-feather="check-circle" class="wd-12 mg-r-5"></i>
          Approve
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Review Action Modal -->
<div class="modal fade" id="reviewActionModal" tabindex="-1" role="dialog" aria-labelledby="reviewActionModalLabel" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="reviewActionModalLabel">
          <i data-feather="message-square" class="wd-16 mg-r-5"></i>
          <span id="actionTitle">Review Request</span>
        </h5>
        <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <form id="reviewActionForm">
        <div class="modal-body">
          <div class="form-group">
            <label for="adminComments">Admin Comments</label>
            <textarea class="form-control" id="adminComments" name="adminComments" rows="4" 
                      placeholder="Add any comments for the user..."></textarea>
            <small class="form-text text-muted">These comments will be visible to the user</small>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn" id="confirmActionBtn">
            <i data-feather="check" class="wd-12 mg-r-5"></i>
            <span id="confirmActionText">Confirm</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('layouts/partials/footer') %>

<script>
    // Global variables
    let currentRequestId = null;
    let currentAction = null;
    let allRequests = [];
    
    // Initialize page
    $(document).ready(function() {
        console.log('=== ADMIN COORDINATOR REQUESTS PAGE INITIALIZED ===');
        loadCoordinatorRequests();
        loadCommunities();
        
        // Event listeners
        $('#statusFilter, #communityFilter').on('change', filterRequests);
        $('#searchInput').on('input', filterRequests);
        
        $('#approveBtn').on('click', function() {
            currentAction = 'approve';
            showReviewActionModal();
        });
        
        $('#rejectBtn').on('click', function() {
            currentAction = 'reject';
            showReviewActionModal();
        });
        
        $('#reviewActionForm').on('submit', function(e) {
            e.preventDefault();
            submitReviewAction();
        });
    });
    
    // Load coordinator requests
    function loadCoordinatorRequests() {
        console.log('=== LOADING COORDINATOR REQUESTS ===');
        
        $.ajax({
            url: '/api/coordinator-requests',
            method: 'GET',
            success: function(response) {
                console.log('=== COORDINATOR REQUESTS LOADED ===');
                console.log('Response:', response);
                
                allRequests = response.data.requests;
                renderRequests(allRequests);
            },
            error: function(xhr) {
                console.error('=== LOAD COORDINATOR REQUESTS ERROR ===');
                console.error('Error:', xhr);
                
                $('#requestsTableBody').html(`
                    <tr>
                        <td colspan="7" class="text-center text-danger">
                            <i data-feather="alert-circle" class="wd-16 mg-r-5"></i>
                            Failed to load coordinator requests. Please try again.
                        </td>
                    </tr>
                `);
            }
        });
    }
    
    // Load communities for filter
    function loadCommunities() {
        $.ajax({
            url: '/api/communities',
            method: 'GET',
            success: function(response) {
                const communities = response.data.communities;
                const communityFilter = $('#communityFilter');
                
                communities.forEach(community => {
                    communityFilter.append(`
                        <option value="${community.id}">${community.name}</option>
                    `);
                });
            },
            error: function(xhr) {
                console.error('Failed to load communities:', xhr);
            }
        });
    }
    
    // Render requests table
    function renderRequests(requests) {
        const tbody = $('#requestsTableBody');
        
        if (requests.length === 0) {
            tbody.html(`
                <tr>
                    <td colspan="7" class="text-center text-muted">
                        <i data-feather="inbox" class="wd-16 mg-r-5"></i>
                        No coordinator requests found
                    </td>
                </tr>
            `);
            return;
        }
        
        let html = '';
        requests.forEach(request => {
            const statusBadge = getStatusBadge(request.status);
            const requestedDate = new Date(request.requestedAt).toLocaleDateString();
            
            html += `
                <tr>
                    <td>
                        <div class="d-flex align-items-center">
                            <img src="${request.user.avatarUrl || '/assets/img/avatar.webp'}" style="width: 40px; height: 40px;"
                                 class="rounded-circle wd-32 mg-r-10" alt="Avatar">
                            <div>
                                <div class="tx-weight-600">${request.user.displayName || request.user.username}</div>
                                <small class="tx-color-03">${request.user.email}</small>
                            </div>
                        </div>
                    </td>
                    <td>
                        <div class="tx-weight-600">${request.community.name}</div>
                        <small class="tx-color-03">${request.community.region} - ${request.community.district}</small>
                    </td>
                    <td>${request.position}</td>
                    <td>${request.organization}</td>
                    <td>${statusBadge}</td>
                    <td>${requestedDate}</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" onclick="reviewRequest('${request.id}')">
                            <i data-feather="eye" class="wd-12 mg-r-5"></i>
                            Review
                        </button>
                    </td>
                </tr>
            `;
        });
        
        tbody.html(html);
        feather.replace();
    }
    
    // Get status badge HTML
    function getStatusBadge(status) {
        const badges = {
            pending: '<span class="badge badge-warning">Pending</span>',
            approved: '<span class="badge badge-success">Approved</span>',
            rejected: '<span class="badge badge-danger">Rejected</span>'
        };
        return badges[status] || '<span class="badge badge-secondary">Unknown</span>';
    }
    
    // Filter requests
    function filterRequests() {
        const statusFilter = $('#statusFilter').val();
        const communityFilter = $('#communityFilter').val();
        const searchTerm = $('#searchInput').val().toLowerCase();
        
        let filtered = allRequests;
        
        if (statusFilter) {
            filtered = filtered.filter(request => request.status === statusFilter);
        }
        
        if (communityFilter) {
            filtered = filtered.filter(request => request.community.id === communityFilter);
        }
        
        if (searchTerm) {
            filtered = filtered.filter(request => 
                (request.user.displayName && request.user.displayName.toLowerCase().includes(searchTerm)) ||
                (request.user.username && request.user.username.toLowerCase().includes(searchTerm)) ||
                (request.organization && request.organization.toLowerCase().includes(searchTerm))
            );
        }
        
        renderRequests(filtered);
    }
    
    // Review request
    function reviewRequest(requestId) {
        console.log('=== REVIEWING REQUEST ===');
        console.log('Request ID:', requestId);
        
        const request = allRequests.find(r => r.id === requestId);
        if (!request) {
            console.error('Request not found:', requestId);
            return;
        }
        
        currentRequestId = requestId;
        
        const content = `
            <div class="row">
                <div class="col-md-6">
                    <h6>User Information</h6>
                    <div class="d-flex align-items-center mg-b-15">
                        <img src="${request.user.avatarUrl || '/assets/img/avatar.webp'}" style="width: 100px; height: 100px;"
                             class="rounded-circle wd-48 mg-r-15" alt="Avatar">
                        <div>
                            <div class="tx-weight-600">${request.user.displayName || request.user.username}</div>
                            <small class="tx-color-03">${request.user.email}</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <h6>Community</h6>
                    <div class="tx-weight-600">${request.community.name}</div>
                    <small class="tx-color-03">${request.community.region} - ${request.community.district}</small>
                </div>
            </div>
            
            <hr>
            
            <div class="row">
                <div class="col-md-6">
                    <h6>Position</h6>
                    <p>${request.position}</p>
                </div>
                <div class="col-md-6">
                    <h6>Organization</h6>
                    <p>${request.organization}</p>
                </div>
            </div>
            
            <div class="mg-t-20">
                <h6>Request Details</h6>
                <div class="bg-light pd-15 rounded">
                    <p class="mg-b-0">${request.requestDetails}</p>
                </div>
            </div>
            
            ${request.attachment ? `
                <div class="mg-t-20">
                    <h6>Attachment</h6>
                    <a href="/uploads/coordinator-requests/${request.attachment.filename}" 
                       target="_blank" class="btn btn-outline-primary btn-sm">
                        <i data-feather="download" class="wd-12 mg-r-5"></i>
                        ${request.attachment.originalName}
                    </a>
                </div>
            ` : ''}
            
            <div class="mg-t-20">
                <h6>Request Status</h6>
                <div class="d-flex align-items-center">
                    ${getStatusBadge(request.status)}
                    <small class="tx-color-03 mg-l-10">
                        Requested: ${new Date(request.requestedAt).toLocaleString()}
                    </small>
                </div>
            </div>
        `;
        
        $('#reviewRequestContent').html(content);
        $('#reviewRequestModal').modal('show');
        feather.replace();
    }
    
    // Show review action modal
    function showReviewActionModal() {
        const actionText = currentAction === 'approve' ? 'Approve' : 'Reject';
        const actionColor = currentAction === 'approve' ? 'success' : 'danger';
        
        $('#actionTitle').text(`${actionText} Request`);
        $('#confirmActionText').text(actionText);
        $('#confirmActionBtn').removeClass('btn-success btn-danger').addClass(`btn-${actionColor}`);
        
        $('#reviewActionModal').modal('show');
    }
    
    // Submit review action
    function submitReviewAction() {
        const adminComments = $('#adminComments').val();
        
        console.log('=== SUBMITTING REVIEW ACTION ===');
        console.log('Request ID:', currentRequestId);
        console.log('Action:', currentAction);
        console.log('Comments:', adminComments);
        
        $.ajax({
            url: `/api/coordinator-requests/${currentRequestId}/review`,
            method: 'PUT',
            data: {
                action: currentAction,
                adminComments: adminComments
            },
            success: function(response) {
                console.log('=== REVIEW ACTION SUBMITTED ===');
                console.log('Response:', response);
                
                Swal.fire({
                    title: 'Success!',
                    text: `Request ${currentAction}d successfully`,
                    icon: 'success',
                    confirmButtonText: 'OK',
                    confirmButtonColor: '#28a745'
                }).then(() => {
                    $('#reviewRequestModal').modal('hide');
                    $('#reviewActionModal').modal('hide');
                    loadCoordinatorRequests(); // Reload requests
                });
            },
            error: function(xhr) {
                console.error('=== REVIEW ACTION ERROR ===');
                console.error('Error:', xhr);
                
                const errorMessage = xhr.responseJSON?.message || 'Failed to submit review action. Please try again.';
                
                Swal.fire({
                    title: 'Error',
                    text: errorMessage,
                    icon: 'error',
                    confirmButtonText: 'OK'
                });
            }
        });
    }
</script>

<%- include('layouts/partials/bottom-files') %>
