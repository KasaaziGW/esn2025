        const isOwnMessage = message.sender._id === '<%= user._id || user.id %>';
        
        // Clear welcome message if it exists
        container.find('.text-center').remove();
        
        let messageContent = '';
        if (message.forwardedAnnouncement) {
            // Special formatting for forwarded announcements
            messageContent = `
                <div class="forwarded-announcement" style="border: 1px solid #e3e6f0; border-radius: 8px; padding: 12px; background: #f8f9fc; margin: 8px 0;">
                    <div class="d-flex align-items-center mg-b-8">
                        <i data-feather="share-2" class="wd-16 ht-16 tx-primary mg-r-5"></i>
                        <span class="tx-weight-600 tx-primary">Forwarded Announcement</span>
                    </div>
                    <div class="announcement-preview">
                        <h6 class="tx-weight-600 mg-b-5">${escapeHtml(message.content.split('**')[1] || 'Announcement')}</h6>
                        <p class="tx-color-03 mg-b-10">${escapeHtml(message.content.split('\n\n')[1] || message.content)}</p>
                        <div class="d-flex align-items-center justify-content-between">
                            <small class="tx-color-03">${message.content.split('*Originally posted by ')[1]?.split('*')[0] || 'Unknown'}</small>
                            <a href="http://localhost:5000/announcements" class="btn btn-sm btn-outline-primary" target="_blank">
                                <i data-feather="external-link" class="wd-12 mg-r-2"></i>
                                Read More
                            </a>
                        </div>
                    </div>
                </div>
            `;
        } else if (message.type === 'image') {
            messageContent = `<img src="${message.content}" class="img-fluid rounded mg-b-10" style="max-width: 200px;" alt="Image">`;
        } else if (message.type === 'file') {
            messageContent = `<a href="${message.content}" target="_blank" class="d-flex align-items-center"><i data-feather="file" class="mg-r-5"></i>File attachment</a>`;
        } else {
            messageContent = `<p>${escapeHtml(message.content)}</p>`;
        }
        
        const messageHtml = `
            <div class="media ${isOwnMessage ? 'justify-content-end' : ''}" data-message-id="${message._id}">
                ${!isOwnMessage ? `
                    <div class="avatar avatar-sm mg-r-10" onclick="viewUserProfile('${message.sender._id}', '${message.sender.displayName || message.sender.username}')" style="cursor: pointer;">
                        ${message.sender.avatarUrl ? 
                            `<img src="${message.sender.avatarUrl}" class="rounded-circle" alt="${message.sender.displayName || message.sender.username}">` :
                            `<span class="avatar-initial rounded-circle">${(message.sender.displayName || message.sender.username || 'U').charAt(0).toUpperCase()}</span>`
                        }
                    </div>
                ` : ''}
                <div class="media-body ${isOwnMessage ? 'text-end' : ''}">
                    <div class="message-bubble ${isOwnMessage ? 'own-message' : 'other-message'}">
                        <div class="message-content">${messageContent}</div>
                        <div class="message-time">${formatTime12Hour(message.createdAt)}</div>
                    </div>
                </div>
                ${isOwnMessage ? `
                    <div class="avatar avatar-sm mg-l-10">
                        ${message.sender.avatarUrl ? 
                            `<img src="${message.sender.avatarUrl}" class="rounded-circle" alt="${message.sender.displayName || message.sender.username}">` :
                            `<span class="avatar-initial rounded-circle">${(message.sender.displayName || message.sender.username || 'U').charAt(0).toUpperCase()}</span>`
                        }
                    </div>
                ` : ''}
            </div>
        `;
        
        container.append(messageHtml);
        feather.replace();
        scrollToBottom();
    }
    
    // Send message
    function sendMessage() {
        const input = $('#messageInput');
        const content = input.val().trim();
        
        console.log('Attempting to send message:', { content, currentChatId, currentChatUser });
        
        if (!content) {
            // Don't send empty messages - add visual feedback
            input.focus();
            return;
        }
        
        if (!currentChatId) {
            console.log('No chat selected');
            alert('Please select a chat first');
            return;
        }
        
        if (socket && socket.connected) {
            console.log('Sending via Socket.IO');
            socket.emit('privateMessage', {
                recipientId: currentChatUser.id,
                content: content,
                type: 'text'
            });
        } else {
            console.log('Socket not connected, using REST API');
            // Fallback to REST API
            $.ajax({
                url: `/chats/${currentChatId}/messages`,
                method: 'POST',
                data: { content: content, type: 'text' },
                success: function(response) {
                    console.log('Message sent via REST:', response);
                    if (response.data && response.data.message) {
                        displayMessage(response.data.message);
                        scrollToBottom();
                    }
                },
                error: function(xhr) {
                    console.error('Failed to send message:', xhr);
                    alert('Failed to send message. Please try again.');
                }
            });
        }
        
        input.val('');
    }
    
    // Handle key press
    function handleKeyPress(event) {
        if (event.key === 'Enter') {
            event.preventDefault();
            sendMessage();
        }
    }
    
    // Trigger file upload
    function triggerFileUpload() {
        $('#fileUpload').click();
    }
    
    // Handle file upload
    $('#fileUpload').on('change', function(e) {
        const file = e.target.files[0];
        if (!file || !currentChatId) return;
        
        const formData = new FormData();
        formData.append('file', file);
        
        $.ajax({
            url: `/chats/${currentChatId}/messages`,
            method: 'POST',
            data: formData,
            processData: false,
            contentType: false,
            success: function(response) {
                console.log('File sent:', response);
                if (response.data && response.data.message) {
                    displayMessage(response.data.message);
                    scrollToBottom();
                }
                $('#fileUpload').val('');
            },
            error: function(xhr) {
                console.error('Failed to send file:', xhr);
                alert('Failed to send file');
            }
        });
    });
    
    // Update chat list item
    function updateChatListItem(chatId, lastMessage, lastMessageTime) {
        const chatLink = $(`a[onclick*="${chatId}"]`);
        if (chatLink.length) {
            chatLink.find('.flex-grow-1 small').text(lastMessage);
        }
    }
    
    // Scroll to bottom
    function scrollToBottom() {
        const container = $('.chat-content-body');
        container.scrollTop(container[0].scrollHeight);
    }
    
    // Utility functions
    function formatTime(dateString) {
        const date = new Date(dateString);
        const now = new Date();
        const diff = now - date;
        
        if (diff < 60000) return 'Just now';
        if (diff < 3600000) return `${Math.floor(diff / 60000)}m ago`;
        if (diff < 86400000) return `${Math.floor(diff / 3600000)}h ago`;
        return date.toLocaleDateString();
    }
    
    // Format time in 12-hour format (07:17 PM)
    function formatTime12Hour(date) {
        const messageDate = new Date(date);
        return messageDate.toLocaleTimeString('en-US', {
            hour: '2-digit',
            minute: '2-digit',
            hour12: true
        });
    }
    
    function formatDate(dateString) {
        const date = new Date(dateString);
        const today = new Date();
        const yesterday = new Date(today);
        yesterday.setDate(yesterday.getDate() - 1);
        
        if (date.toDateString() === today.toDateString()) {
            return 'Today';
        } else if (date.toDateString() === yesterday.toDateString()) {
            return 'Yesterday';
        } else {
            return date.toLocaleDateString();
        }
    }
    
    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
    
    // View user profile
    function viewUserProfile(userId, userName) {
        // Open profile in a new tab or modal
        window.open(`/profile/${userId}`, '_blank');
    }
    
    
    // Save active chat to localStorage
    function saveActiveChat(chatId, userName, userId) {
        const activeChat = {
            chatId: chatId,
            userName: userName,
            userId: userId,
            timestamp: Date.now()
        };
        localStorage.setItem('activeChat', JSON.stringify(activeChat));
    }
    
    // Restore last active chat from localStorage
    function restoreLastActiveChat() {
        try {
            const savedChat = localStorage.getItem('activeChat');
            if (savedChat) {
                const activeChat = JSON.parse(savedChat);
                // Check if the chat is not too old (within 24 hours)
                const chatAge = Date.now() - activeChat.timestamp;
                if (chatAge < 24 * 60 * 60 * 1000) { // 24 hours
                    console.log('Restoring last active chat:', activeChat);
                    openChat(activeChat.chatId, activeChat.userName, activeChat.userId);
                } else {
                    // Clear old chat data
                    localStorage.removeItem('activeChat');
                }
            }
        } catch (error) {
            console.error('Error restoring last active chat:', error);
            localStorage.removeItem('activeChat');
        }
    }
    
    // Show welcome message when no chat is selected
    function showWelcomeMessage() {
        $('#chatMessages').html(`
            <div class="text-center text-muted pd-y-40">
                <i data-feather="message-square" class="wd-48 mg-b-10"></i>
                <h6>Welcome to Private Chat</h6>
                <p class="tx-color-03">Select a user from the sidebar to start a conversation</p>
            </div>
        `);
        feather.replace();
    }
    
    // Clear current chat and reset state
    function clearCurrentChat() {
        currentChatId = null;
        currentChatUser = null;
        $('#chatMessages').empty();
        $('#chatTitle').addClass('d-none');
        $('#chatNav').addClass('d-none');
        $('#chatFooter').addClass('d-none');
        $('.media').removeClass('active');
        localStorage.removeItem('activeChat');
        showWelcomeMessage();
    }
</script>

