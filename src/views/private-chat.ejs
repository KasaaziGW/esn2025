  <style>
    /* WhatsApp-like message bubbles */
    .message-bubble {
        max-width: 70%;
        min-width: fit-content;
        width: fit-content;
        padding: 8px 12px;
        border-radius: 18px;
        margin: 2px 0;
        position: relative;
        word-wrap: break-word;
        display: inline-block;
    }

    .own-message {
        background-color: #dcf8c6;
        color: #000;
        margin-left: auto;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
    }

    .other-message {
        background-color: #ffffff;
        color: #000;
        border: 1px solid #e5e5e5;
        margin-right: auto;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
    }

    .message-time {
        font-size: 11px;
        color: #999;
        margin-top: 4px;
        text-align: right;
    }

    .own-message .message-time {
        text-align: right;
    }

    .other-message .message-time {
        text-align: left;
    }

    .message-content p {
        margin: 0;
        line-height: 1.4;
    }
    
    /* Ensure proper alignment for message containers */
    .media-body.text-end {
        display: flex;
        justify-content: flex-end;
    }
    
    .media-body:not(.text-end) {
        display: flex;
        justify-content: flex-start;
    }

    /* Date dividers */
    .chat-group-divider {
        text-align: center;
        margin: 20px 0;
        position: relative;
    }

    .chat-group-divider::before {
        content: '';
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 1px;
        background-color: #e5e5e5;
        z-index: 1;
    }

    .chat-group-divider span {
        background-color: #f8f9fa;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: 12px;
        color: #666;
        position: relative;
        z-index: 2;
    }

    /* Online status indicators */
    .avatar-online::after {
        content: '';
        position: absolute;
        bottom: 0;
        right: 0;
        width: 8px;
        height: 8px;
        background-color: #4caf50;
        border: 2px solid #fff;
        border-radius: 50%;
    }

    .avatar-offline::after {
        content: '';
        position: absolute;
        bottom: 0;
        right: 0;
        width: 8px;
        height: 8px;
        background-color: #ccc;
        border: 2px solid #fff;
        border-radius: 50%;
    }
  </style>
  </head>
  <body class="app-chat">

