    <script>
      $(function(){
        'use strict'

        window.darkMode = function(){
          $('.btn-white').addClass('btn-dark').removeClass('btn-white');
        }

        window.lightMode = function() {
          $('.btn-dark').addClass('btn-white').removeClass('btn-dark');
        }

        var hasMode = typeof Cookies !== 'undefined' ? Cookies.get('df-mode') : null;
        if(hasMode === 'dark') {
          darkMode();
        } else {
          lightMode();
        }
      })
    </script>

<script>
    // socket is already declared in bottom-files.ejs
    let currentChatId = null;
    let currentChatUser = null;
    let chatMessages = [];
    
    // Initialize page
    $(document).ready(function() {
        console.log('=== PRIVATE CHAT PAGE INITIALIZED ===');
        console.log('User ID:', '<%= user._id || user.id %>');
        console.log('Socket.IO available:', typeof io !== 'undefined');
        
        // Initialize Socket.IO
        initSocket();
        
        // Load community members
        loadCommunityMembers();
        
        // Load existing private chats
        loadPrivateChats();
        
        // Try to restore last active chat from localStorage
        restoreLastActiveChat();
        
        // If no chat is restored, show welcome message
        setTimeout(() => {
            if (!currentChatId) {
                showWelcomeMessage();
            }
        }, 1000);
        
        // Initialize tooltips
        $('[data-bs-toggle="tooltip"]').tooltip();
        
        // Add click handler for message input
        $('#messageInput').on('keypress', function(e) {
            if (e.which === 13) { // Enter key
                sendMessage();
            }
        });
        
        // Add click handler for send button (if it exists)
        $(document).on('click', '#sendButton', function() {
            sendMessage();
        });
    });
    
    // Initialize Socket.IO connection
    function initSocket() {
        if (typeof io === 'undefined') {
            console.error('Socket.IO not loaded');
            return;
        }
        
        // Use the global socket from bottom-files.ejs or create new one
        socket = window.socket;
        if (!socket) {
            socket = io({
                auth: {
                    userId: '<%= user._id || user.id %>'
                }
            });
            window.socket = socket;
        }
        
        socket.on('connect', () => {
            console.log('Socket connected:', socket.id);
        });
        
        socket.on('disconnect', () => {
            console.log('Socket disconnected');
        });
        
        socket.on('newMessage', (message) => {
            // Fix the comparison - message.chat can be either a string or an object
            const messageChatId = typeof message.chat === 'string' ? message.chat : message.chat._id;
            
            if (messageChatId === currentChatId) {
                // Check if message is not already displayed
                const messageExists = $(`[data-message-id="${message._id}"]`).length > 0;
                if (!messageExists) {
                    displayMessage(message);
                    scrollToBottom();
                }
            }
            // Update chat list to show latest message
            if (message.chat) {
                const chatId = typeof message.chat === 'string' ? message.chat : message.chat._id;
                updateChatListItem(chatId, message.content, message.createdAt);
            }
        });
        
        socket.on('typing', (data) => {
            console.log('Typing indicator:', data);
            // Handle typing indicators if needed
        });
        
    }
    
    // Load community members for starting new chats
    function loadCommunityMembers() {
        $.ajax({
            url: '/community-access/members',
            method: 'GET',
            success: function(response) {
                console.log('Community members loaded:', response);
                if (response.data && response.data.members) {
                    renderCommunityMembers(response.data.members);
                    populateNewChatDropdown(response.data.members);
                } else {
                    console.log('No community members found');
                    $('#communityMembers').html('<p class="text-muted">No community members found</p>');
                }
            },
            error: function(xhr) {
                console.error('Failed to load community members:', xhr);
                $('#communityMembers').html('<p class="text-danger">Failed to load community members</p>');
            }
        });
    }
    
    // Render community members in sidebar
    function renderCommunityMembers(members) {
        const container = $('#communityMembers');
        container.empty();
        
        members.forEach(member => {
            const lastSeen = member.lastSeenAt ? formatTime(member.lastSeenAt) : 'Never';
            
            container.append(`
                <a href="#" class="media" data-member-id="${member._id}" onclick="startChatWithUser('${member._id}', '${member.displayName || member.username}')">
                    <div class="avatar avatar-sm">
                        ${member.avatarUrl ? 
                            `<img src="${member.avatarUrl}" class="rounded-circle" alt="${member.displayName || member.username}">` :
                            `<span class="avatar-initial rounded-circle">${(member.displayName || member.username || 'U').charAt(0).toUpperCase()}</span>`
                        }
                    </div>
                    <div class="media-body mg-l-10">
                        <h6 class="mg-b-0">${member.displayName || member.username}</h6>
                        <small class="d-block tx-color-04">${lastSeen}</small>
                    </div>
                </a>
            `);
        });
        
        feather.replace();
    }
    
    // Populate new chat dropdown
    function populateNewChatDropdown(members) {
        const dropdown = $('#newChatUser');
        dropdown.empty().append('<option value="">Choose a user...</option>');
        
        members.forEach(member => {
            dropdown.append(`<option value="${member._id}">${member.displayName || member.username}</option>`);
        });
    }
    
    // Load existing private chats
    function loadPrivateChats() {
        $.ajax({
            url: '/chats/private',
            method: 'GET',
            success: function(response) {
                console.log('Private chats loaded:', response);
                if (response.data && response.data.chats) {
                    renderPrivateChats(response.data.chats);
                } else {
                    console.log('No private chats found');
                    $('#privateChats').html('<p class="text-muted">No private chats yet</p>');
                }
            },
            error: function(xhr) {
                console.error('Failed to load private chats:', xhr);
                $('#privateChats').html('<p class="text-danger">Failed to load private chats</p>');
            }
        });
    }
    
    // Render private chats in sidebar
    function renderPrivateChats(chats) {
        const container = $('#privateChats');
        container.empty();
        
        chats.forEach(chat => {
            const otherUser = chat.participants.find(p => p._id !== '<%= user._id || user.id %>');
            if (otherUser) {
                const unreadCount = chat.unreadCount || 0;
                const lastMessage = chat.lastMessage || 'No messages yet';
                const lastMessageTime = chat.lastMessageAt ? formatTime(chat.lastMessageAt) : '';
                
                container.append(`
                    <a href="#" class="nav-link" data-user-id="${otherUser._id}" onclick="openChat('${chat._id}', '${otherUser.displayName || otherUser.username}', '${otherUser._id}')">
                        <div class="d-flex align-items-center">
                            <div class="avatar avatar-sm mg-r-8">
                                ${otherUser.avatarUrl ? 
                                    `<img src="${otherUser.avatarUrl}" class="rounded-circle" alt="${otherUser.displayName || otherUser.username}">` :
                                    `<span class="avatar-initial rounded-circle">${(otherUser.displayName || otherUser.username || 'U').charAt(0).toUpperCase()}</span>`
                                }
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mg-b-0">${otherUser.displayName || otherUser.username}</h6>
                                <small class="d-block tx-color-04">${lastMessage}</small>
                            </div>
                            ${unreadCount > 0 ? `<span class="badge text-bg-danger">${unreadCount}</span>` : ''}
                        </div>
                    </a>
                `);
            }
        });
        
        feather.replace();
    }
    
    // Start new chat modal
    function startNewChat() {
        $('#modalNewChat').modal('show');
    }
    
    // Create new chat
    function createNewChat() {
        const userId = $('#newChatUser').val();
        if (!userId) {
            alert('Please select a user');
            return;
        }
        
        $.ajax({
            url: '/chats/private',
            method: 'POST',
            data: { recipientId: userId },
            success: function(response) {
                console.log('New chat created:', response);
                if (response.data && response.data.chat) {
                    const chat = response.data.chat;
                    const otherUser = chat.participants.find(p => p._id !== '<%= user._id || user.id %>');
                    if (otherUser) {
                        openChat(chat._id, otherUser.displayName || otherUser.username, otherUser._id);
                        loadPrivateChats(); // Refresh chat list
                    }
                }
                $('#modalNewChat').modal('hide');
            },
            error: function(xhr) {
                console.error('Failed to create new chat:', xhr);
                alert('Failed to create new chat');
            }
        });
    }
    
    // Start chat with user from community members list
    function startChatWithUser(userId, userName) {
        console.log('Starting chat with user:', { userId, userName });
        
        // Clear previous chat content immediately and show loading message
        $('#chatMessages').empty().html(`
            <div class="text-center text-muted pd-y-40">
                <i data-feather="message-square" class="wd-48 mg-b-10"></i>
                <h6>Starting conversation with @${userName}</h6>
                <p class="tx-color-03">Please wait...</p>
            </div>
        `);
        feather.replace();
        
        // Check if chat already exists
        $.ajax({
            url: `/chats/private/with/${userId}`,
            method: 'GET',
            success: function(response) {
                console.log('Chat check response:', response);
                if (response.data && response.data.chat) {
                    console.log('Existing chat found:', response.data.chat._id);
                    openChat(response.data.chat._id, userName, userId);
                } else {
                    console.log('No existing chat, creating new one');
                    // Create new chat
                    $.ajax({
                        url: '/chats/private',
                        method: 'POST',
                        data: { recipientId: userId },
                        success: function(response) {
                            console.log('New chat created:', response);
                            if (response.data && response.data.chat) {
                                openChat(response.data.chat._id, userName, userId);
                                loadPrivateChats(); // Refresh chat list
                            }
                        },
                        error: function(xhr) {
                            console.error('Failed to create chat:', xhr);
                            alert('Failed to create chat. Please try again.');
                        }
                    });
                }
            },
            error: function(xhr) {
                console.error('Failed to check existing chat:', xhr);
                alert('Failed to check for existing chat. Please try again.');
            }
        });
    }
    
    // Open chat with user
    function openChat(chatId, userName, userId) {
        console.log('Opening chat:', { chatId, userName, userId });
        currentChatId = chatId;
        currentChatUser = { id: userId, name: userName };
        
        // Clear previous chat content immediately and show loading message
        $('#chatMessages').empty().html(`
            <div class="text-center text-muted pd-y-40">
                <i data-feather="message-square" class="wd-48 mg-b-10"></i>
                <h6>Loading conversation with @${userName}</h6>
                <p class="tx-color-03">Please wait...</p>
            </div>
        `);
        feather.replace();
        
        // Update UI
        $('#chatTitle').removeClass('d-none').find('h6').text(`@${userName}`);
        $('#chatNav').removeClass('d-none');
        $('#chatFooter').removeClass('d-none');
        
        // Join socket room
        if (socket && socket.connected) {
            socket.emit('joinChat', { chatId: chatId });
            console.log('Joined chat room:', chatId);
        }
        
        // Load chat messages
        loadChatMessages(chatId);
        
        // Mark as active in sidebar
        $('.media').removeClass('active');
        $(`a[onclick*="${chatId}"]`).addClass('active');
        
        // Save active chat to localStorage
        saveActiveChat(chatId, userName, userId);
        
        console.log('Chat opened successfully');
    }
    
    // Load chat messages
    function loadChatMessages(chatId) {
        $.ajax({
            url: `/chats/${chatId}/messages`,
            method: 'GET',
            success: function(response) {
                console.log('Chat messages loaded:', response);
                if (response.data && Array.isArray(response.data)) {
                    // Response.data is directly the messages array
                    chatMessages = response.data;
                    renderMessages(response.data);
                    scrollToBottom();
                } else if (response.data && response.data.messages) {
                    // Response.data has a messages property
                    chatMessages = response.data.messages;
                    renderMessages(response.data.messages);
                    scrollToBottom();
                } else {
                    console.log('No messages found');
                    $('#chatMessages').html(`
                        <div class="text-center text-muted pd-y-40">
                            <i data-feather="message-square" class="wd-48 mg-b-10"></i>
                            <h6>No messages yet</h6>
                            <p class="tx-color-03">Start the conversation!</p>
                        </div>
                    `);
                    feather.replace();
                }
            },
            error: function(xhr) {
                console.error('Failed to load chat messages:', xhr);
            }
        });
    }
    
    // Render messages
    function renderMessages(messages) {
        console.log('renderMessages called with:', messages);
        console.log('Messages count:', messages ? messages.length : 0);
        const container = $('#chatMessages');
        console.log('Container element:', container);
        container.empty();
        
        if (messages.length === 0) {
            container.html(`
                <div class="text-center text-muted pd-y-40">
                    <i data-feather="message-square" class="wd-48 mg-b-10"></i>
                    <h6>No messages yet</h6>
                    <p class="tx-color-03">Start the conversation!</p>
                </div>
            `);
            feather.replace();
            return;
        }
        
        let currentDate = null;
        
        messages.forEach((message, index) => {
            const messageDate = new Date(message.createdAt).toDateString();
            const isOwnMessage = message.sender._id === '<%= user._id || user.id %>';
            
            // Add date divider if needed
            if (currentDate !== messageDate) {
                currentDate = messageDate;
                container.append(`<div class="chat-group-divider"><span>${formatDate(message.createdAt)}</span></div>`);
            }
            
            // Message content
            let messageContent = '';
            if (message.forwardedAnnouncement) {
                // Special formatting for forwarded announcements
                messageContent = `
                    <div class="forwarded-announcement" style="border: 1px solid #e3e6f0; border-radius: 8px; padding: 12px; background: #f8f9fc; margin: 8px 0;">
                        <div class="d-flex align-items-center mg-b-8">
                            <i data-feather="share-2" class="wd-16 ht-16 tx-primary mg-r-5"></i>
                            <span class="tx-weight-600 tx-primary">Forwarded Announcement</span>
                        </div>
                        <div class="announcement-preview">
                            <h6 class="tx-weight-600 mg-b-5">${escapeHtml(message.content.split('**')[1] || 'Announcement')}</h6>
                            <p class="tx-color-03 mg-b-10">${escapeHtml(message.content.split('\n\n')[1] || message.content)}</p>
                            <div class="d-flex align-items-center justify-content-between">
                                <small class="tx-color-03">${message.content.split('*Originally posted by ')[1]?.split('*')[0] || 'Unknown'}</small>
                                <a href="http://localhost:5000/announcements" class="btn btn-sm btn-outline-primary" target="_blank">
                                    <i data-feather="external-link" class="wd-12 mg-r-2"></i>
                                    Read More
                                </a>
                            </div>
                        </div>
                    </div>
                `;
            } else if (message.type === 'image') {
                messageContent = `<img src="${message.content}" class="img-fluid rounded mg-b-10" style="max-width: 200px;" alt="Image">`;
            } else if (message.type === 'file') {
                messageContent = `<a href="${message.content}" target="_blank" class="d-flex align-items-center"><i data-feather="file" class="mg-r-5"></i>File attachment</a>`;
            } else {
                messageContent = `<p>${escapeHtml(message.content)}</p>`;
            }
            
            const messageHtml = `
                <div class="media ${isOwnMessage ? 'justify-content-end' : ''}" data-message-id="${message._id}">
                    ${!isOwnMessage ? `
                        <div class="avatar avatar-sm mg-r-10" onclick="viewUserProfile('${message.sender._id}', '${message.sender.displayName || message.sender.username}')" style="cursor: pointer;">
                            ${message.sender.avatarUrl ? 
                                `<img src="${message.sender.avatarUrl}" class="rounded-circle" alt="${message.sender.displayName || message.sender.username}">` :
                                `<span class="avatar-initial rounded-circle">${(message.sender.displayName || message.sender.username || 'U').charAt(0).toUpperCase()}</span>`
                            }
                        </div>
                    ` : ''}
                    <div class="media-body ${isOwnMessage ? 'text-end' : ''}">
                        <div class="message-bubble ${isOwnMessage ? 'own-message' : 'other-message'}">
                            <div class="message-content">${messageContent}</div>
                            <div class="message-time">${formatTime12Hour(message.createdAt)}</div>
                        </div>
                    </div>
                    ${isOwnMessage ? `
                        <div class="avatar avatar-sm mg-l-10">
                            ${message.sender.avatarUrl ? 
                                `<img src="${message.sender.avatarUrl}" class="rounded-circle" alt="${message.sender.displayName || message.sender.username}">` :
                                `<span class="avatar-initial rounded-circle">${(message.sender.displayName || message.sender.username || 'U').charAt(0).toUpperCase()}</span>`
                            }
                        </div>
                    ` : ''}
                </div>
            `;
            
            container.append(messageHtml);
        });
        
        console.log('Messages rendered, final container HTML length:', container.html().length);
        console.log('Container children count:', container.children().length);
        feather.replace();
    }
    
    // Display new message
    function displayMessage(message) {
