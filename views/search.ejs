<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('templates/head') %>
</head>
<body>
    <%- include('templates/navbar') %>
    
    <!-- Search Content -->
    <div class="search-content">
        <div class="search-container">
            <div class="search-header">
                <h2>Search Information</h2>
                <p>Search for citizens, messages, and more</p>
            </div>

            <div class="search-tabs">
                <button class="tab-button active" data-context="citizens">Citizens</button>
                <button class="tab-button" data-context="status">Status</button>
                <button class="tab-button" data-context="public-messages">Public Messages</button>
                <button class="tab-button" data-context="private-messages">Private Messages</button>
            </div>

            <div class="search-form-container">
                <form id="searchForm" class="search-form">
                    <div class="search-input-group">
                        <input type="text" id="searchInput" class="search-input" placeholder="Enter your search criteria..." required>
                        <button type="submit" class="search-button">
                            <i class="fas fa-search"></i>
                            Search
                        </button>
                    </div>
                    <div id="searchContext" class="search-context">
                        <p>Current context: <span id="currentContext">Citizens</span></p>
                        <small id="searchHint">Enter a username or part of a username</small>
                    </div>
                </form>
            </div>

            <div class="search-results-container">
                <div id="searchResults" class="search-results">
                    <!-- Search results will be dynamically inserted here -->
                </div>
                <div id="loadMore" class="load-more" style="display: none;">
                    <button class="load-more-button">
                        <i class="fas fa-sync"></i>
                        Load More Results
                    </button>
                </div>
                <div id="noResults" class="no-results" style="display: none;">
                    <i class="fas fa-search"></i>
                    <p>No results found</p>
                    <small>Try different search criteria</small>
                </div>
            </div>
        </div>
    </div>

    <style>
        .search-content {
            padding: 2rem;
            height: calc(100vh - 60px);
            overflow-y: auto;
        }

        .search-container {
            max-width: 1200px;
            margin: 0 auto;
            background: white;
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            padding: 2rem;
        }

        .search-header {
            text-align: center;
            margin-bottom: 2rem;
        }

        .search-header h2 {
            color: #1f2937;
            font-size: 2rem;
            margin-bottom: 0.5rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .search-header p {
            color: #6b7280;
            font-size: 1.1rem;
        }

        .search-tabs {
            display: flex;
            gap: 1rem;
            margin-bottom: 2rem;
            overflow-x: auto;
            padding-bottom: 0.5rem;
        }

        .tab-button {
            padding: 0.75rem 1.5rem;
            border: none;
            border-radius: 8px;
            background: #f3f4f6;
            color: #4b5563;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .tab-button:hover {
            background: #e5e7eb;
        }

        .tab-button.active {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .search-form-container {
            margin-bottom: 2rem;
        }

        .search-input-group {
            display: flex;
            gap: 1rem;
        }

        .search-input {
            flex: 1;
            padding: 1rem 1.5rem;
            border: 2px solid #e5e7eb;
            border-radius: 12px;
            font-size: 1rem;
            transition: all 0.3s ease;
        }

        .search-input:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .search-button {
            padding: 1rem 2rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .search-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        }

        .search-context {
            margin-top: 1rem;
            color: #6b7280;
        }

        .search-context p {
            margin: 0;
            font-weight: 500;
        }

        #currentContext {
            color: #667eea;
        }

        .search-results {
            display: grid;
            gap: 1rem;
            margin-bottom: 1rem;
        }

        .result-card {
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 1.5rem;
            transition: all 0.3s ease;
        }

        .result-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        .citizen-result {
            display: flex;
            align-items: center;
            gap: 1rem;
        }

        .citizen-avatar {
            width: 50px;
            height: 50px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
        }

        .citizen-info {
            flex: 1;
        }

        .citizen-name {
            font-weight: 600;
            color: #1f2937;
            margin: 0;
        }

        .citizen-status {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-top: 0.25rem;
        }

        .status-indicator {
            width: 8px;
            height: 8px;
            border-radius: 50%;
        }

        .status-ok { background: #10b981; }
        .status-help { background: #f59e0b; }
        .status-emergency { background: #ef4444; }

        .message-result {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .message-header {
            display: flex;
            justify-content: space-between;
            color: #6b7280;
            font-size: 0.9rem;
        }

        .message-content {
            color: #1f2937;
            font-size: 1rem;
            line-height: 1.5;
        }

        .load-more {
            text-align: center;
            margin-top: 2rem;
        }

        .load-more-button {
            padding: 0.75rem 1.5rem;
            background: #f3f4f6;
            border: none;
            border-radius: 8px;
            color: #4b5563;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
        }

        .load-more-button:hover {
            background: #e5e7eb;
        }

        .no-results {
            text-align: center;
            padding: 3rem;
            color: #6b7280;
        }

        .no-results i {
            font-size: 3rem;
            margin-bottom: 1rem;
            opacity: 0.5;
        }

        @media (max-width: 768px) {
            .search-content {
                padding: 1rem;
            }

            .search-container {
                padding: 1rem;
            }

            .search-input-group {
                flex-direction: column;
            }

            .search-button {
                width: 100%;
                justify-content: center;
            }

            .search-tabs {
                padding-bottom: 0.5rem;
                margin: -0.5rem -1rem 1.5rem -1rem;
                padding: 0.5rem 1rem;
            }
        }
    </style>

    <script src="js/search.js"></script>
    <%- include('templates/footer') %>
</body>
</html>