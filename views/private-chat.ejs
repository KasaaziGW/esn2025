<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("templates/head"); %>
    <script src="https://cdn.socket.io/4.8.1/socket.io.min.js" crossorigin="anonymous"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <style>
        /* -------------------- Chat Layout -------------------- */
        .chat-container {
            max-width: 800px;
            margin: 2rem auto;
            display: flex;
            flex-direction: column;
            background: white;
            border-radius: 15px;
            border: 1px solid #e5e7eb;
            overflow: hidden;
            height: 80vh; /* ensures input stays visible */
        }
        .chat-messages {
            flex: 1;
            padding: 1.5rem;
            overflow-y: auto;
            background: #f8fafc;
            min-height: 400px;
        }
        .chat-input-container {
            padding: 1rem 1.5rem;
            background: white;
            flex-shrink: 0;
        }
        .input-group {
            display: flex;
            gap: 1rem;
            align-items: flex-end;
        }
        .message-input {
            flex: 1;
            padding: 1rem 1.25rem;
            border: 2px solid #e5e7eb;
            border-radius: 25px;
            font-size: 1rem;
            background: #f8fafc;
            resize: none;
        }
        .send-button {
            padding: 1rem 1.5rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            min-height: 50px;
        }
        .send-button:hover { transform: translateY(-2px); box-shadow: 0 4px 15px rgba(102,126,234,0.4); }

        /* -------------------- Messages -------------------- */
        .message { margin-bottom: 1rem; display: flex; flex-direction: column; }
        .message.own { align-items: flex-end; }
        .message.other { align-items: flex-start; }
        .message-content { max-width: 70%; padding: 0.75rem 1rem; border-radius: 15px; word-wrap: break-word; }
        .message.own .message-content { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; }
        .message.other .message-content { background: white; border: 1px solid #e5e7eb; color: #1f2937; }
        .message-header { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem; }
        .message-sender { font-weight: 600; font-size: 0.85rem; }
        .message-time { font-size: 0.75rem; color: rgba(0,0,0,0.65); }
    </style>
</head>
<body>
    <%- include('templates/navbar') %>

    <div class="chat-container">
        <div id="chat-box" class="chat-messages"></div>

        <div class="chat-input-container">
            <form id="chat-form" class="chat-form">
                <input type="hidden" id="current-user-email" value="<%= user.email %>">
                <input type="hidden" id="receiver-email" value="<%= receiverEmail %>">

                <div class="input-group">
                    <input type="text" id="message-input" class="message-input" placeholder="Type your message..." required autocomplete="off">
                    <button type="submit" class="send-button" id="sendButton">
                        <i class="fas fa-paper-plane"></i> Send
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        const socket = io();
        const chatBox = $("#chat-box");
        const currentUserEmail = $("#current-user-email").val();
        const receiverEmail = $("#receiver-email").val();
        const messageInput = $("#message-input");
        const chatForm = $("#chat-form");

        function escapeHtml(str) { if (!str) return ""; return String(str).replace(/[&<>"']/g, m => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[m]); }
        function getCurrentTime() {
            const d = new Date();
            const pad = n => n < 10 ? '0'+n : n;
            const date = [pad(d.getDate()), pad(d.getMonth()+1), d.getFullYear()].join("-");
            const time = [pad(d.getHours()), pad(d.getMinutes()), pad(d.getSeconds())].join(":");
            const ampm = d.getHours() >= 12 ? "PM" : "AM";
            return `${date} ${time} ${ampm}`;
        }
        function scrollToBottom() { chatBox.scrollTop(chatBox.prop("scrollHeight")); }

        function appendMessage(msg) {
            const isOwn = msg.sender === currentUserEmail;
            const html = `
                <div class="message ${isOwn ? 'own' : 'other'}">
                    <div class="message-header">
                        <span class="message-sender">${isOwn ? 'You' : escapeHtml(msg.sender)}</span>
                        <span class="message-time">${msg.sentTime}</span>
                    </div>
                    <div class="message-content">
                        <div class="message-text">${escapeHtml(msg.message)}</div>
                    </div>
                </div>`;
            chatBox.append(html);
            scrollToBottom();
        }

        // Fetch previous messages
        function fetchPrivateMessages() {
            $.get(`/fetchPrivateMessages?sender=${encodeURIComponent(currentUserEmail)}&receiver=${encodeURIComponent(receiverEmail)}`)
            .done(data => { chatBox.empty(); data.forEach(appendMessage); })
            .fail(() => console.error("Failed to fetch private messages"));
        }
        fetchPrivateMessages();

        // Send message
        chatForm.on("submit", function(e){
            e.preventDefault(); // prevent page reload
            const text = messageInput.val().trim();
            if(!text) return;

            const msg = {
                sender: currentUserEmail,
                receiver: receiverEmail,
                message: text,
                sentTime: getCurrentTime()
            };

            // append immediately
            appendMessage(msg);
            messageInput.val("");

            // Save to server
            $.post("/sendPrivateMessage", msg).fail(() => console.error("Failed to send private message"));

            // Emit via socket
            socket.emit("sendPrivateMessage", msg);
        });

        // Join private room
        socket.emit("joinPrivate", { sender: currentUserEmail, receiver: receiverEmail });

        socket.on("privateMessage", msg => {
            // Only show messages not sent by current user (avoids duplicates)
            if(msg.sender !== currentUserEmail &&
               ((msg.sender === receiverEmail && msg.receiver === currentUserEmail) ||
                (msg.sender === currentUserEmail && msg.receiver === receiverEmail))) {
                appendMessage(msg);
            }
        });
    </script>

    <script src="js/navbar.js"></script>
    <%- include('templates/footer') %>
</body>
</html>
