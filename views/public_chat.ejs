<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("templates/head"); %>
    <script src="https://cdn.socket.io/4.8.1/socket.io.min.js" integrity="sha384-mkQ3/7FUtcGyoppY6bz/PORYoGqOl7/aSUMn2ymDOJcapfS6PHqxhRTMh1RR0Q6+" crossorigin="anonymous"></script>
</head>
<body>
    <%- include('templates/navbar') %>
    
    <!-- Chat Content -->
    <div class="chat-content">
        <div class="chat-container">
            <div id="chat-box" class="chat-messages">
                <!-- Chat messages will appear here -->
            </div>
            
            <div class="chat-input-container">
                <form id="chat-form" class="chat-form">
                    <input type="text" id="username" value="<%= user.fullname %>" readonly required hidden>
                    <div class="input-group">
                        <input type="text" id="message-input" class="message-input" placeholder="Type your message..." required autocomplete="off">
                        <button type="submit" class="send-button" id="sendButton">
                            <i class="fas fa-paper-plane"></i> Send
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <style>
        /* Chat Layout */
        .chat-content {
            padding: 2rem;
            height: calc(100vh - 60px);
            display: flex;
            justify-content: center;
            align-items: stretch;
        }
        .chat-container {
            width: 100%;
            max-width: 720px;
            display: flex;
            flex-direction: column;
            background: white;
            border-radius: 15px;
            border: 1px solid #e5e7eb;
            overflow: hidden;
        }
        .chat-messages {
            flex: 1;
            padding: 1.5rem;
            overflow-y: auto;
            background: #f8fafc;
        }
        .chat-input-container {
            padding: 1rem 1.5rem;
            background: white;
            flex-shrink: 0;
        }
        .chat-form { width: 100%; }
        .input-group {
            display: flex;
            gap: 1rem;
            align-items: flex-end;
        }
        .message-input {
            flex: 1;
            padding: 1rem 1.25rem;
            border: 2px solid #e5e7eb;
            border-radius: 25px;
            font-size: 1rem;
            background: #f8fafc;
            transition: all 0.3s ease;
            resize: none;
            min-height: 50px;
            max-height: 120px;
        }
        .message-input:focus {
            outline: none;
            border-color: #667eea;
            background: white;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }
        .send-button {
            padding: 1rem 1.5rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 25px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            min-height: 50px;
        }
        .send-button:hover { transform: translateY(-2px); box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4); }
        .send-button:active { transform: translateY(0); }

        /* New Message Design */
        .message-container {
            margin-bottom: 1.5rem;
            display: flex;
            flex-direction: column;
        }
        .message-container.own { align-items: flex-end; }
        .message-container.other { align-items: flex-start; }

        .message-bubble {
            max-width: 70%;
            padding: 1rem 1.25rem;
            border-radius: 18px;
            word-wrap: break-word;
            position: relative;
        }
        .message-container.own .message-bubble {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-bottom-right-radius: 6px;
        }
        .message-container.other .message-bubble {
            background: white;
            color: #1f2937;
            border: 1px solid #e5e7eb;
            border-bottom-left-radius: 6px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        .message-header {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-bottom: 0.5rem;
            flex-wrap: wrap;
        }
        .message-container.own .message-header { justify-content: flex-end; }
        .message-container.other .message-header { justify-content: flex-start; }

        .user-name {
            font-weight: 600;
            font-size: 0.8rem;
            opacity: 0.9;
        }
        .message-container.own .user-name { color: rgba(255,255,255,0.9); }
        .message-container.other .user-name { color: #667eea; }

        .message-time {
            font-size: 0.7rem;
            padding: 0.2rem 0.5rem;
            border-radius: 8px;
            font-weight: 500;
            opacity: 0.8;
        }
        .message-container.own .message-time {
            color: rgba(255,255,255,0.8);
            background: rgba(0,0,0,0.15);
        }
        .message-container.other .message-time {
            color: #6b7280;
            background: #f3f4f6;
        }

        .user-status {
            display: flex;
            align-items: center;
            gap: 0.3rem;
            font-size: 0.7rem;
            font-weight: 600;
            padding: 0.2rem 0.5rem;
            border-radius: 8px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .message-container.own .user-status {
            background: rgba(0,0,0,0.15);
            color: rgba(255,255,255,0.9);
        }
        .message-container.other .user-status {
            background: #f3f4f6;
            color: #374151;
        }

        .user-status.ok {
            background: rgba(16, 185, 129, 0.2);
            color: #10b981;
        }
        .user-status.help {
            background: rgba(245, 158, 11, 0.2);
            color: #f59e0b;
        }
        .user-status.emergency {
            background: rgba(239, 68, 68, 0.2);
            color: #ef4444;
        }
        .message-container.own .user-status.ok {
            background: rgba(16, 185, 129, 0.3);
            color: rgba(255,255,255,0.9);
        }
        .message-container.own .user-status.help {
            background: rgba(245, 158, 11, 0.3);
            color: rgba(255,255,255,0.9);
        }
        .message-container.own .user-status.emergency {
            background: rgba(239, 68, 68, 0.3);
            color: rgba(255,255,255,0.9);
        }

        .status-icon {
            font-weight: bold;
            font-size: 0.8rem;
        }

        .message-text {
            font-size: 1rem;
            line-height: 1.5;
            font-weight: 400;
        }

        .join-notification {
            text-align: center;
            color: #6b7280;
            font-style: italic;
            font-size: 0.9rem;
            margin: 0.5rem 0;
            padding: 0.5rem;
            background: rgba(102, 126, 234, 0.1);
            border-radius: 10px;
        }

        @media (max-width: 768px) {
            .chat-content { padding: 1rem; }
            .input-group { flex-direction: column; gap: 0.75rem; }
            .send-button { width: 100%; justify-content: center; }
            .message-bubble { max-width: 85%; }
            .message-header { gap: 0.5rem; }
            .user-name, .message-time, .user-status { font-size: 0.7rem; }
            .message-text { font-size: 0.9rem; }
        }
    </style>

    <script>
    const socket = io();
    const chatBox = $("#chat-box");
    const usernameInput = $("#username");
    const messageInput = $("#message-input");
    const sendButton = $("#sendButton");
    const currentUser = usernameInput.val();

    function escapeHtml(str) {
        if (!str) return "";
        return String(str).replace(/[&<>"']/g, m => ({
            "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
        }[m]));
    }

    // ✅ Corrected timestamp function (no "OK" hardcode)
    function getCurrentTime() {
        const d = new Date();
        const pad = n => n < 10 ? '0' + n : n;
        const date = [pad(d.getDate()), pad(d.getMonth() + 1), d.getFullYear()].join("-");
        const time = [pad(d.getHours()), pad(d.getMinutes()), pad(d.getSeconds())].join(":");
        const ampm = d.getHours() >= 12 ? "PM" : "AM";
        return `${date} ${time} ${ampm}`;
    }

    function scrollToBottom() {
        chatBox.scrollTop(chatBox.prop("scrollHeight"));
    }

    // ✅ Format time to 09:01PM format
    function formatTime(timeString) {
        if (!timeString) return '';
        
        let date;
        
        try {
            // Handle the specific format: "24-10-2025 19:27:36 PM"
            if (timeString.includes('-') && timeString.includes(':')) {
                const parts = timeString.split(' ');
                if (parts.length >= 2) {
                    const datePart = parts[0]; // "24-10-2025"
                    const timePart = parts[1]; // "19:27:36"
                    const ampmPart = parts[2] || ''; // "PM"
                    
                    // Parse date components: DD-MM-YYYY
                    const dateComponents = datePart.split('-');
                    if (dateComponents.length === 3) {
                        const day = parseInt(dateComponents[0]);
                        const month = parseInt(dateComponents[1]) - 1; // JavaScript months are 0-based
                        const year = parseInt(dateComponents[2]);
                        
                        // Parse time components: HH:MM:SS
                        const timeComponents = timePart.split(':');
                        if (timeComponents.length >= 2) {
                            let hours = parseInt(timeComponents[0]);
                            const minutes = parseInt(timeComponents[1]);
                            
                            // Handle AM/PM if present
                            if (ampmPart.toUpperCase() === 'PM' && hours !== 12) {
                                hours += 12;
                            } else if (ampmPart.toUpperCase() === 'AM' && hours === 12) {
                                hours = 0;
                            }
                            
                            date = new Date(year, month, day, hours, minutes, 0);
                        }
                    }
                }
            } else {
                // Try direct parsing for other formats
                date = new Date(timeString);
            }
            
            // If date is still invalid, use current time
            if (isNaN(date.getTime())) {
                date = new Date();
            }
            
        } catch (e) {
            // Fallback to current time if parsing fails
            date = new Date();
        }
        
        const hours = date.getHours();
        const minutes = date.getMinutes();
        const ampm = hours >= 12 ? 'PM' : 'AM';
        const displayHours = hours % 12 || 12;
        const displayMinutes = minutes < 10 ? '0' + minutes : minutes;
        return `${displayHours}:${displayMinutes}${ampm}`;
    }

    // ✅ Append messages with redesigned layout
    function appendMessage(msg) {
        const isOwn = msg.sender === currentUser;
        const status = (msg.sender_status || "OK").toLowerCase();

        // Choose icons dynamically
        const statusIcon = status === "ok" ? "✓"
            : status === "help" ? "!"
            : status === "emergency" ? "+"
            : "?";

        const formattedTime = formatTime(msg.sentTime);
        const displayName = isOwn ? 'You' : escapeHtml(msg.sender);
        
        // Debug logging to help identify time format issues
        if (formattedTime.includes('NaN')) {
            console.log('Time formatting issue:', msg.sentTime, '->', formattedTime);
        }

        const html = `
            <div class="message-container ${isOwn ? 'own' : 'other'}">
                <div class="message-bubble">
                    <div class="message-header">
                        <span class="user-name">${displayName}</span>
                        <span class="message-time">${formattedTime}</span>
                        <span class="user-status ${status}">
                            <span class="status-icon">${statusIcon}</span>
                            <span class="status-text">${escapeHtml(msg.sender_status || 'OK')}</span>
                        </span>
                    </div>
                    <div class="message-text">${escapeHtml(msg.message)}</div>
                </div>
            </div>
        `;
        chatBox.append(html);
        scrollToBottom();
    }

    // ✅ Load all existing messages on page load
    function fetchMessages() {
        $.get("/fetchMessages")
            .done(data => {
                chatBox.empty();
                data.forEach(appendMessage);
            })
            .fail(() => console.error("Failed to fetch messages"));
    }

    fetchMessages();

    // ✅ Send message through the API
    sendButton.click(e => {
        e.preventDefault();
        const text = messageInput.val().trim();
        if (!text) return;
        const msg = { sender: currentUser, message: text, sentTime: getCurrentTime() };

        $.post("/sendMessage", msg)
            .done(response => {
                appendMessage(response.message);
                messageInput.val("");
            })
            .fail(() => console.error("Failed to send message"));
    });

    // ✅ Listen for new messages in real-time
    socket.on("message", msg => {
        if (msg.sender !== currentUser) appendMessage(msg);
    });

    // ✅ Show join notifications
    socket.on("joined", user => {
        const text = user === currentUser
            ? "You have joined the chat"
            : `${user} has joined the chat`;
        chatBox.append(`<div class="join-notification">${escapeHtml(text)}</div>`);
        scrollToBottom();
    });

    $(function () {
        socket.emit("joined", currentUser);
    });
</script>

    <script src="js/navbar.js"></script>
    <%- include('templates/footer') %>
</body>
</html>
