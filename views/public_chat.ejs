<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("templates/head"); %>
    <script src="https://cdn.socket.io/4.8.1/socket.io.min.js" integrity="sha384-mkQ3/7FUtcGyoppY6bz/PORYoGqOl7/aSUMn2ymDOJcapfS6PHqxhRTMh1RR0Q6+" crossorigin="anonymous"></script>
</head>
<body>
    <%- include('templates/navbar') %>
    
    <!-- Chat Content -->
    <div class="chat-content">
        <div class="chat-container">
            <div id="chat-box" class="chat-messages">
                <!-- Chat messages will appear here -->
            </div>
            
            <div class="chat-input-container">
                <form id="chat-form" class="chat-form">
                    <input type="text" id="username" value="<%= user.fullname %>" readonly required hidden>
                    <div class="input-group">
                        <input type="text" id="message-input" class="message-input" placeholder="Type your message..." required autocomplete="off">
                        <button type="submit" class="send-button" id="sendButton">
                            <i class="fas fa-paper-plane"></i>
                            Send
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <style>
        .chat-content {
            padding: 2rem;
            height: calc(100vh - 60px);
            display: flex;
            flex-direction: column;
        }
        
        .chat-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: white;
            border-radius: 15px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            border: 1px solid #e5e7eb;
            overflow: hidden;
        }
        
        .chat-messages {
            flex: 1;
            padding: 1.5rem;
            overflow-y: auto;
            background: #f8fafc;
            border-bottom: 1px solid #e5e7eb;
        }
        
        .chat-messages::-webkit-scrollbar {
            width: 6px;
        }
        
        .chat-messages::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        
        .chat-messages::-webkit-scrollbar-thumb {
            background: #c1c1c1;
            border-radius: 3px;
        }
        
        .chat-messages::-webkit-scrollbar-thumb:hover {
            background: #a8a8a8;
        }
        
        .message {
            margin-bottom: 1rem;
            display: flex;
            flex-direction: column;
        }
        
        .message.own {
            align-items: flex-end;
        }
        
        .message.other {
            align-items: flex-start;
        }
        
        .message-content {
            max-width: 70%;
            padding: 0.75rem 1rem;
            border-radius: 15px;
            position: relative;
            word-wrap: break-word;
        }
        
        .message.own .message-content {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-bottom-right-radius: 5px;
        }
        
        .message.other .message-content {
            background: white;
            color: #1f2937;
            border: 1px solid #e5e7eb;
            border-bottom-left-radius: 5px;
        }
        
        .message-header {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.25rem;
        }
        
        .message.own .message-header {
            justify-content: flex-end;
        }
        
        .message.other .message-header {
            justify-content: flex-start;
        }
        
        .message-sender {
            font-weight: 600;
            font-size: 0.85rem;
        }
        
        .message.own .message-sender {
            color: rgba(255,255,255,0.8);
        }
        
        .message.other .message-sender {
            color: #667eea;
        }
        
        .message-time {
            font-size: 0.75rem;
            color: rgba(0,0,0,0.5);
        }
        
        .message.own .message-time {
            color: rgba(255,255,255,0.7);
        }
        
        .message-text {
            line-height: 1.4;
        }
        
        .join-notification {
            text-align: center;
            color: #6b7280;
            font-style: italic;
            font-size: 0.9rem;
            margin: 0.5rem 0;
            padding: 0.5rem;
            background: rgba(102, 126, 234, 0.1);
            border-radius: 10px;
        }
        
        .chat-input-container {
            padding: 1.5rem;
            background: white;
        }
        
        .chat-form {
            width: 100%;
        }
        
        .input-group {
            display: flex;
            gap: 1rem;
            align-items: flex-end;
        }
        
        .message-input {
            flex: 1;
            padding: 1rem 1.25rem;
            border: 2px solid #e5e7eb;
            border-radius: 25px;
            font-size: 1rem;
            background: #f8fafc;
            transition: all 0.3s ease;
            resize: none;
            min-height: 50px;
            max-height: 120px;
        }
        
        .message-input:focus {
            outline: none;
            border-color: #667eea;
            background: white;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }
        
        .message-input::placeholder {
            color: #9ca3af;
        }
        
        .send-button {
            padding: 1rem 1.5rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 25px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            min-height: 50px;
            white-space: nowrap;
        }
        
        .send-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4);
        }
        
        .send-button:active {
            transform: translateY(0);
        }
        
        .send-button:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }
        
        @media (max-width: 768px) {
            .chat-content {
                padding: 1rem;
            }
            
            .input-group {
                flex-direction: column;
                gap: 0.75rem;
            }
            
            .send-button {
                width: 100%;
                justify-content: center;
            }
            
            .message-content {
                max-width: 85%;
            }

            .custom-text{
                font-size: 8pt;
                text-transform: capitalize;
            }

        }
    </style>
    <script>
        const socket = io();
        
        $(() => {
            $("#sendButton").click(() => {
                const fullname = $("#username").val();
                const sentmessage = $("#message-input").val();
                const currentTime = getCurrentTime();
                
                var message = {
                    sender: fullname,
                    message: sentmessage,
                    sentTime: currentTime
                }
                saveMessage(message);
                $("#message-input").val("");
            });
            
            // Allow sending message with Enter key
            $("#message-input").keypress((e) => {
                if (e.which === 13) {
                    $("#sendButton").click();
                }
            });
        });
        
        fetchMessages();
        
        // Receive the "joined" event from the server
        socket.on("joined", (user) => {
            var username = $("#username").val();
            if(user == username){
                $("#chat-box").append(`<div class="join-notification">You have joined the chat</div>`);
            } else {
                $("#chat-box").append(`<div class="join-notification">${user} has joined the chat</div>`);
            }
            scrollToBottom();
        });
        
        socket.on("message", (message) => {
            var username = $("#username").val();
            const isOwnMessage = message.sender === username;
            
            const messageHtml = `
                <div class="message ${isOwnMessage ? 'own' : 'other'}">
                    <div class="message-header">
                        <span class="message-sender">${isOwnMessage ? 'You' : message.sender}</span>
                        <span class="message-time">${message.sentTime}</span>
                       
                    </div>
                    <div class="message-content">
                        <div class="message-text">${message.message}</div>
                         <div style="font-size:6pt; color:${isOwnMessage ?'white':'grey'}; text-transform:capitalize;"> ${(message?.sender_status)?'Status: '.message?.sender_status?.current_state:''}</div>
                    </div>
                </div>
            `;
            
            $("#chat-box").append(messageHtml);
            scrollToBottom();
        });

        // Function to get current time in HH:MM format
        function getCurrentTime() {
            var today = new Date();
            var currentDate = [
                today.getDate(),
                today.getMonth() + 1,
                today.getFullYear(),
            ];
            var currentTime = [today.getHours(), today.getMinutes(), today.getSeconds()];
            var suffix = currentTime[0] >= 12 ? "PM" : "AM";
            currentDate[0] = currentDate[0] < 10 ? "0" + currentDate[0] : currentDate[0];
            currentDate[1] = currentDate[1] < 10 ? "0" + currentDate[1] : currentDate[1];

            currentTime[0] = currentTime[0] < 10 ? "0" + currentTime[0] : currentTime[0];
            currentTime[1] = currentTime[1] < 10 ? "0" + currentTime[1] : currentTime[1];
            currentTime[2] = currentTime[2] < 10 ? "0" + currentTime[2] : currentTime[2];

            return currentDate.join("-") + " " + currentTime.join(":") + " " + suffix;
        }

        function saveMessage(message){
            $.post("/sendMessage", message);
        }
        
        // Function to retrieve messages from the server
        function fetchMessages() {
            $.get("/fetchMessages", (data) => {
                data.forEach((message) => {
                    var username = $("#username").val();
                    const isOwnMessage = message.sender === username;
                    
                    const messageHtml = `
                        <div class="message ${isOwnMessage ? 'own' : 'other'}">
                            <div class="message-header">
                                <span class="message-sender">${isOwnMessage ? 'You' : message.sender}</span>
                                <span class="message-time">${message.sentTime}</span>
                             </div>
                            <div class="message-content">
                                <div class="message-text">${message.message}</div>
                                <div style="font-size:6pt; color:${isOwnMessage ?'white':'grey'}; text-transform:capitalize;"> Status: <strong>${message?.sender_status?.current_state || 'undefined'}<strong></div>
                            </div>
                        </div>
                    `;
                    
                    $("#chat-box").append(messageHtml);
                });
                scrollToBottom();
            });
        }
        
        function scrollToBottom() {
            const chatBox = document.getElementById('chat-box');
            chatBox.scrollTop = chatBox.scrollHeight;
        }
    </script>
    
    <script src="js/navbar.js"></script>
    <%- include('templates/footer') %>
    
</body>
</html>