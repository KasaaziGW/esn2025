<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("templates/head"); %>
    <script src="https://cdn.socket.io/4.8.1/socket.io.min.js" integrity="sha384-mkQ3/7FUtcGyoppY6bz/PORYoGqOl7/aSUMn2ymDOJcapfS6PHqxhRTMh1RR0Q6+" crossorigin="anonymous"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <style>
        /* -------------------- Chat Layout -------------------- */
        .chat-content {
            padding: 2rem;
            height: calc(100vh - 60px);
            display: flex;
            flex-direction: row;
            gap: 1rem;
            align-items: stretch;
        }

        .chat-container {
            flex: 1;
            display: flex;
            flex-direction: column;
            background: white;
            border-radius: 15px;
            border: 1px solid #e5e7eb;
            overflow: hidden;
        }

        .chat-messages {
            flex: 1;
            padding: 1.5rem;
            overflow-y: auto;
            background: #f8fafc;
        }

        .chat-input-container {
            padding: 1rem 1.5rem;
            background: white;
            flex-shrink: 0;
        }

        .chat-form { width: 100%; }
        .input-group {
            display: flex;
            gap: 1rem;
            align-items: flex-end;
        }
        .message-input {
            flex: 1;
            padding: 1rem 1.25rem;
            border: 2px solid #e5e7eb;
            border-radius: 25px;
            font-size: 1rem;
            background: #f8fafc;
            transition: all 0.3s ease;
            resize: none;
            min-height: 50px;
            max-height: 120px;
        }
        .message-input:focus {
            outline: none;
            border-color: #667eea;
            background: white;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }
        .send-button {
            padding: 1rem 1.5rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 25px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            min-height: 50px;
        }
        .send-button:hover { transform: translateY(-2px); box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4); }
        .send-button:active { transform: translateY(0); }
        .send-button:disabled { opacity: 0.6; cursor: not-allowed; }

        /* -------------------- Messages -------------------- */
        .message {
            margin-bottom: 1rem;
            display: flex;
            flex-direction: column;
        }
        .message.own { align-items: flex-end; }
        .message.other { align-items: flex-start; }

        .message-content {
            max-width: 70%;
            padding: 0.75rem 1rem;
            border-radius: 15px;
            word-wrap: break-word;
        }
        .message.own .message-content {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-bottom-right-radius: 5px;
        }
        .message.other .message-content {
            background: white;
            color: #1f2937;
            border: 1px solid #e5e7eb;
            border-bottom-left-radius: 5px;
        }

        .message-header {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.25rem;
        }
        .message.own .message-header { justify-content: flex-end; }
        .message.other .message-header { justify-content: flex-start; }

        .message-sender { font-weight: 600; font-size: 0.85rem; }
        .message.own .message-sender { color: rgba(255,255,255,0.9); }
        .message.other .message-sender { color: #667eea; }

        /* NOTE: message-time made darker and with subtle background for legibility */
        .message-time {
            font-size: 0.75rem;
            padding: 0 0.35rem;
            border-radius: 4px;
            color: rgba(0,0,0,0.65);
            background: rgba(255,255,255,0.6);
        }

        .message.own .message-time {
            color: rgba(255,255,255,0.9);
            background: rgba(0,0,0,0.12);
        }

        .message-text { line-height: 1.4; }

        .join-notification {
            text-align: center;
            color: #6b7280;
            font-style: italic;
            font-size: 0.9rem;
            margin: 0.5rem 0;
            padding: 0.5rem;
            background: rgba(102, 126, 234, 0.1);
            border-radius: 10px;
        }

        /* -------------------- Sidebar -------------------- */
        .users-sidebar {
            width: 260px; /* slightly wider for icons */
            background: #f9fafb;
            padding: 1rem;
            border-left: 1px solid #e5e7eb;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            max-height: calc(100vh - 60px);
        }
        .users-sidebar h3 { margin-bottom: 1rem; font-size: 1.1rem; font-weight: 600; color: #111827; }
        .users-sidebar ul { list-style: none; padding: 0; margin: 0; }

        .user-item {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.5rem 0.25rem;
            margin-bottom: 0.25rem;
            border-radius: 8px;
            font-size: 0.95rem;
            transition: background 0.15s;
        }
        .user-item:hover { background-color: #f3f4f6; cursor: default; }

        .status {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            flex-shrink: 0;
        }
        .status.online { background-color: #34d399; box-shadow: 0 0 0 3px rgba(52,211,153,0.08); }
        .status.offline { background-color: #9ca3af; }

        .user-main {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            min-width: 0;
        }

        .user-name {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: #111827;
            font-weight: 500;
        }

        .user-icons {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-left: 0.5rem;
        }

        .user-status {
            font-size: 1rem;
            width: 30px;
            height: 26px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 6px;
        }

        /* color icons (we show icon only) */
        .user-status.ok { color: #10b981; }          /* green check */
        .user-status.help { color: #f59e0b; }        /* yellow exclamation */
        .user-status.emergency { color: #ef4444; }   /* red plus */

        .user-email-icon {
            font-size: 0.95rem;
            color: #374151;
            padding: 6px;
            border-radius: 6px;
            cursor: pointer;
        }
        .user-email-icon:hover { background: rgba(55,65,81,0.06); }

        @media (max-width: 768px) {
            .chat-content { padding: 1rem; flex-direction: column; }
            .input-group { flex-direction: column; gap: 0.75rem; }
            .send-button { width: 100%; justify-content: center; }
            .message-content { max-width: 85%; }
            .users-sidebar { width: 100%; max-height: 240px; order: -1; } /* mobile: put users on top */
        }
    </style>
</head>
<body>
    <%- include('templates/navbar') %>

    <div class="chat-content">
        <!-- Chat Messages -->
        <div class="chat-container">
            <div id="chat-box" class="chat-messages"></div>

            <div class="chat-input-container">
                <form id="chat-form" class="chat-form">
                    <!-- Hidden user info -->
                    <input type="text" id="username" value="<%= user.fullname %>" data-email="<%= user.email %>" readonly required hidden>

                    <div class="input-group">
                        <input type="text" id="message-input" class="message-input" placeholder="Type your message..." required autocomplete="off">
                        <button type="submit" class="send-button" id="sendButton">
                            <i class="fas fa-paper-plane"></i> Send
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Users Sidebar -->
        <div class="users-sidebar">
            <h3>Users</h3>
            <ul id="users-list"></ul>
        </div>
    </div>

    <script>
        /*
          public_chat.ejs — client-side script
          - keeps original public chat behavior
          - populates users sidebar (email icon navigates to /private-chat)
          - updates status UI live when server emits 'statusUpdated'
          - safe: does not change server-side routes or socket event names
        */

        const socket = io();

        // -------------------- Messages --------------------
        function appendMessage(message) {
            const fullname = $("#username").val();
            const isOwn = message.sender === fullname;

            const html = `
                <div class="message ${isOwn ? 'own' : 'other'}">
                    <div class="message-header">
                        <span class="message-sender">${isOwn ? 'You' : message.sender}</span>
                        <span class="message-time">${message.sentTime}</span>
                    </div>
                    <div class="message-content">
                        <div class="message-text">${escapeHtml(message.message)}</div>
                    </div>
                </div>
            `;
            $("#chat-box").append(html);
            scrollToBottom();
        }

        function scrollToBottom() {
            const chatBox = document.getElementById('chat-box');
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        // Send message: keep same endpoint /sendMessage
        $("#sendButton").click((e) => {
            e.preventDefault();
            const fullname = $("#username").val();
            const messageText = $("#message-input").val();
            if(!messageText || !messageText.trim()) return;
            const message = {
                sender: fullname,
                message: messageText,
                sentTime: getCurrentTime()
            };
            // Save and broadcast (server handles public message save)
            saveMessage(message);
            appendMessage(message);
            $("#message-input").val("");
        });

        function saveMessage(message) {
            $.post("/sendMessage", message).fail(() => {
                console.error("Failed to save message");
            });
        }

        // fetch and show history
        function fetchMessages() {
            $.get("/fetchMessages", (data) => {
                $("#chat-box").empty();
                data.forEach(appendMessage);
                scrollToBottom();
            }).fail(() => {
                console.error("Failed to fetch messages");
            });
        }
        fetchMessages();

        // server -> client events for public chat
        socket.on("joined", user => {
            const fullname = $("#username").val();
            const text = user === fullname ? "You have joined the chat" : `${user} has joined the chat`;
            $("#chat-box").append(`<div class="join-notification">${escapeHtml(text)}</div>`);
            scrollToBottom();
        });

        socket.on("message", message => {
            appendMessage(message);
        });

        // -------------------- Users Sidebar --------------------
        function populateUsers() {
            $.get("/getUsers", (users) => {
                const usersList = $("#users-list");
                usersList.empty();
                const currentUser = $("#username").val();

                users.forEach(user => {
                    // normalize status to string safely (handles legacy object-shaped status)
                    let statusVal = 'OK';
                    if (user && user.status) {
                        if (typeof user.status === 'string') statusVal = user.status;
                        else if (typeof user.status === 'object' && user.status.current_state) statusVal = String(user.status.current_state);
                    }
                    const statusClass = (statusVal || 'OK').toLowerCase(); // ok/help/emergency
                    const onlineClass = user.online ? "online" : "offline";

                    // choose icon markup only (no text) so small
                    let statusIcon = '';
                    if(statusClass === 'ok') statusIcon = '<i class="fas fa-check" aria-hidden="true"></i>';
                    else if(statusClass === 'help') statusIcon = '<i class="fas fa-exclamation" aria-hidden="true"></i>';
                    else if(statusClass === 'emergency') statusIcon = '<i class="fas fa-plus" aria-hidden="true"></i>';

                    // user item uses data-email for reliable lookups later
                    const itemHtml = `
                        <li class="user-item" data-email="${escapeAttr(user.email)}" data-fullname="${escapeAttr(user.fullname)}">
                            <span class="status ${onlineClass}" title="${user.online ? 'Online' : 'Offline'}"></span>

                            <div class="user-main">
                                <span class="user-name">${escapeHtml(user.fullname)}</span>
                                <div class="user-icons" style="margin-left:auto;">
                                    <span class="user-email-icon" title="Start private chat" data-email="${escapeAttr(user.email)}" data-name="${escapeAttr(user.fullname)}">
                                        <i class="fas fa-envelope"></i>
                                    </span>
                                    <span class="user-status ${statusClass}" title="${escapeAttr(user.status || 'OK')}">
                                        ${statusIcon}
                                    </span>
                                </div>
                            </div>
                        </li>
                    `;
                    usersList.append(itemHtml);
                });

            }).fail(() => {
                console.error("Failed to fetch users");
            });
        }

        // initial and periodic refresh
        populateUsers();
        setInterval(populateUsers, 10000);

        // -------------------- Status update UI & events --------------------
        // When server broadcasts a statusUpdated event, update sidebar accordingly
        socket.on("statusUpdated", (user) => {
            // server sends { fullname, status } or { email, status }
            // prefer matching by email if available in data.
            $("#users-list .user-item").each(function () {
                const li = $(this);
                const email = li.data("email");
                const fullname = li.data("fullname");
                // match by fullname or email
                    if ((user.email && user.email === email) || (user.fullname && user.fullname === fullname)) {
                    // normalize incoming status from server
                    let stVal = '';
                    if (user && user.status) {
                        if (typeof user.status === 'string') stVal = user.status;
                        else if (typeof user.status === 'object' && user.status.current_state) stVal = String(user.status.current_state);
                    }
                    const st = (stVal || '').toLowerCase();
                    const iconHtml = st === 'ok' ? '<i class="fas fa-check"></i>' : (st === 'help' ? '<i class="fas fa-exclamation"></i>' : '<i class="fas fa-plus"></i>');
                    li.find(".user-status").attr("class", `user-status ${escapeAttr(st)}`).html(iconHtml).attr("title", user.status || "");
                }
            });
        });

        // manual change flow (prompt) for the current user only — triggers server update
        // clicking the status icon will prompt user to change their status (OK/Help/Emergency)
        $(document).on("click", ".user-status", function(e) {
            const li = $(this).closest(".user-item");
            const fullname = li.data("fullname");
            const myFullname = $("#username").val();
            if(fullname !== myFullname) {
                // only allow changing your own status via sidebar (prevent others)
                return;
            }

            const newStatus = prompt("Change your status (OK, Help, Emergency):", $(this).attr("title") || "OK");
            if(!newStatus) return;
            const allowed = ["OK","Help","Emergency"];
            if(!allowed.includes(newStatus)) {
                alert("Invalid status. Use OK, Help, or Emergency.");
                return;
            }

            const statusLower = newStatus.toLowerCase();
            const iconHtml = statusLower === 'ok' ? '<i class="fas fa-check"></i>' : (statusLower === 'help' ? '<i class="fas fa-exclamation"></i>' : '<i class="fas fa-plus"></i>');

            // update UI immediately
            $(this).attr("class", `user-status ${statusLower}`).html(iconHtml).attr("title", newStatus);

            // emit to server; server will persist and broadcast to others
            socket.emit("updateStatus", { email: $("#username").data("email"), status: newStatus });
        });

        // -------------------- Start private chat when envelope clicked --------------------
        // Clicking the envelope navigates to private chat view with query params.
        $(document).on("click", ".user-email-icon", function () {
            const email = $(this).data("email");
            const name = $(this).data("name");
            if(!email) return;
            // navigate to private chat route
            window.location.href = `/private-chat?email=${encodeURIComponent(email)}&name=${encodeURIComponent(name)}`;
        });

        // -------------------- Helpers & small UX improvements --------------------
        // Escape HTML to avoid injection (simple)
        function escapeHtml(str) {
            if(str === null || str === undefined) return "";
            return String(str).replace(/[&<>"']/g, function (m) {
                return ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[m];
            });
        }
        function escapeAttr(str) {
            if(str === null || str === undefined) return "";
            return String(str).replace(/["']/g, function (m) {
                return ({ '"': "&quot;", "'": "&#39;" })[m];
            });
        }

        // get formatted time like your existing code
        function getCurrentTime() {
            const d = new Date();
            const pad = n => n < 10 ? '0' + n : n;
            const date = [pad(d.getDate()), pad(d.getMonth() + 1), d.getFullYear()].join("-");
            const time = [pad(d.getHours()), pad(d.getMinutes()), pad(d.getSeconds())].join(":");
            const ampm = d.getHours() >= 12 ? "PM" : "AM";
            return `${date} ${time} ${ampm}`;
        }

        // Optional: emit a join event with your fullname so server can announce it (server already sends joined sometimes)
        $(function () {
            const fullname = $("#username").val();
            if (fullname) {
                // emit to server (server may already broadcast a 'joined' event using a global username variable)
                socket.emit("joined", fullname);
            }
        });
    </script>

    <script src="js/navbar.js"></script>
    <%- include('templates/footer') %>
</body>
</html>
