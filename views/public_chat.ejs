<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("templates/head"); %>
    <script src="https://cdn.socket.io/4.8.1/socket.io.min.js" integrity="sha384-mkQ3/7FUtcGyoppY6bz/PORYoGqOl7/aSUMn2ymDOJcapfS6PHqxhRTMh1RR0Q6+" crossorigin="anonymous"></script>
</head>
<body>
    <%- include('templates/navbar') %>
    
    <!-- Chat Content -->
    <div class="chat-content">
        <div class="chat-container">
            <div id="chat-box" class="chat-messages">
                <!-- Chat messages will appear here -->
            </div>
            
            <div class="chat-input-container">
                <form id="chat-form" class="chat-form">
                    <input type="text" id="username" value="<%= user.fullname %>" readonly required hidden>
                    <div class="input-group">
                        <input type="text" id="message-input" class="message-input" placeholder="Type your message..." required autocomplete="off">
                        <button type="submit" class="send-button" id="sendButton">
                            <i class="fas fa-paper-plane"></i> Send
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <style>
        /* Chat Layout */
        .chat-content {
            padding: 2rem;
            height: calc(100vh - 60px);
            display: flex;
            justify-content: center;
            align-items: stretch;
        }
        .chat-container {
            width: 100%;
            max-width: 720px;
            display: flex;
            flex-direction: column;
            background: white;
            border-radius: 15px;
            border: 1px solid #e5e7eb;
            overflow: hidden;
        }
        .chat-messages {
            flex: 1;
            padding: 1.5rem;
            overflow-y: auto;
            background: #f8fafc;
        }
        .chat-input-container {
            padding: 1rem 1.5rem;
            background: white;
            flex-shrink: 0;
        }
        .chat-form { width: 100%; }
        .input-group {
            display: flex;
            gap: 1rem;
            align-items: flex-end;
        }
        .message-input {
            flex: 1;
            padding: 1rem 1.25rem;
            border: 2px solid #e5e7eb;
            border-radius: 25px;
            font-size: 1rem;
            background: #f8fafc;
            transition: all 0.3s ease;
            resize: none;
            min-height: 50px;
            max-height: 120px;
        }
        .message-input:focus {
            outline: none;
            border-color: #667eea;
            background: white;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }
        .send-button {
            padding: 1rem 1.5rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 25px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            min-height: 50px;
        }
        .send-button:hover { transform: translateY(-2px); box-shadow: 0 4px 15px rgba(102, 126, 234, 0.4); }
        .send-button:active { transform: translateY(0); }

        /* Messages */
        .message {
            margin-bottom: 1rem;
            display: flex;
            flex-direction: column;
        }
        .message.own { align-items: flex-end; }
        .message.other { align-items: flex-start; }

        .message-content {
            max-width: 70%;
            padding: 0.75rem 1rem;
            border-radius: 15px;
            word-wrap: break-word;
        }
        .message.own .message-content {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-bottom-right-radius: 5px;
        }
        .message.other .message-content {
            background: white;
            color: #1f2937;
            border: 1px solid #e5e7eb;
            border-bottom-left-radius: 5px;
        }

        .message-header {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            margin-bottom: 0.25rem;
        }
        .message.own .message-header { justify-content: flex-end; }
        .message.other .message-header { justify-content: flex-start; }

        .message-sender { font-weight: 600; font-size: 0.85rem; }
        .message.own .message-sender { color: rgba(255,255,255,0.9); }
        .message.other .message-sender { color: #667eea; }

        .message-time {
            font-size: 0.75rem;
            padding: 0 0.35rem;
            border-radius: 4px;
            color: rgba(0,0,0,0.65);
            background: rgba(255,255,255,0.6);
        }
        .message.own .message-time {
            color: rgba(255,255,255,0.9);
            background: rgba(0,0,0,0.12);
        }
        .message-text { line-height: 1.4; }

        .join-notification {
            text-align: center;
            color: #6b7280;
            font-style: italic;
            font-size: 0.9rem;
            margin: 0.5rem 0;
            padding: 0.5rem;
            background: rgba(102, 126, 234, 0.1);
            border-radius: 10px;
        }

        @media (max-width: 768px) {
            .chat-content { padding: 1rem; }
            .input-group { flex-direction: column; gap: 0.75rem; }
            .send-button { width: 100%; justify-content: center; }
            .message-content { max-width: 85%; }
        }
    </style>

    <script>
    const socket = io();
    const chatBox = $("#chat-box");
    const usernameInput = $("#username");
    const messageInput = $("#message-input");
    const sendButton = $("#sendButton");
    const currentUser = usernameInput.val();

    function escapeHtml(str) {
        if (!str) return "";
        return String(str).replace(/[&<>"']/g, m => ({
            "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;"
        }[m]));
    }

    // ✅ Corrected timestamp function (no "OK" hardcode)
    function getCurrentTime() {
        const d = new Date();
        const pad = n => n < 10 ? '0' + n : n;
        const date = [pad(d.getDate()), pad(d.getMonth() + 1), d.getFullYear()].join("-");
        const time = [pad(d.getHours()), pad(d.getMinutes()), pad(d.getSeconds())].join(":");
        const ampm = d.getHours() >= 12 ? "PM" : "AM";
        return `${date} ${time} ${ampm}`;
    }

    function scrollToBottom() {
        chatBox.scrollTop(chatBox.prop("scrollHeight"));
    }

    // ✅ Append messages with real-time status icon + label
    function appendMessage(msg) {
        const isOwn = msg.sender === currentUser;
        const status = (msg.sender_status || "OK").toLowerCase();

        // Choose icons dynamically
        const statusIcon = status === "ok" ? "✔️"
            : status === "help" ? "⚠️"
            : status === "emergency" ? "🚨"
            : "❔";

        const html = `
            <div class="message ${isOwn ? 'own' : 'other'}">
                <div class="message-header">
                    <span class="message-sender">${isOwn ? 'You' : escapeHtml(msg.sender)}</span>
                    <span class="message-time">${escapeHtml(msg.sentTime)}</span>
                    <span class="user-status ${status}" title="${escapeHtml(msg.sender_status)}">
                        ${statusIcon} ${escapeHtml(msg.sender_status || 'OK')}
                    </span>
                </div>
                <div class="message-content">
                    <div class="message-text">${escapeHtml(msg.message)}</div>
                </div>
            </div>
        `;
        chatBox.append(html);
        scrollToBottom();
    }

    // ✅ Load all existing messages on page load
    function fetchMessages() {
        $.get("/fetchMessages")
            .done(data => {
                chatBox.empty();
                data.forEach(appendMessage);
            })
            .fail(() => console.error("Failed to fetch messages"));
    }

    fetchMessages();

    // ✅ Send message through the API
    sendButton.click(e => {
        e.preventDefault();
        const text = messageInput.val().trim();
        if (!text) return;
        const msg = { sender: currentUser, message: text, sentTime: getCurrentTime() };

        $.post("/sendMessage", msg)
            .done(response => {
                appendMessage(response.message);
                messageInput.val("");
            })
            .fail(() => console.error("Failed to send message"));
    });

    // ✅ Listen for new messages in real-time
    socket.on("message", msg => {
        if (msg.sender !== currentUser) appendMessage(msg);
    });

    // ✅ Show join notifications
    socket.on("joined", user => {
        const text = user === currentUser
            ? "You have joined the chat"
            : `${user} has joined the chat`;
        chatBox.append(`<div class="join-notification">${escapeHtml(text)}</div>`);
        scrollToBottom();
    });

    $(function () {
        socket.emit("joined", currentUser);
    });
</script>

    <script src="js/navbar.js"></script>
    <%- include('templates/footer') %>
</body>
</html>
