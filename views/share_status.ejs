<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('templates/head') %>

</head>
<body>
    <%- include('templates/navbar') %>
    
    <!-- Directory Content -->
    <div class="directory-content">
        <div class="page-header">
            <h2>Share Status</h2>
            <p>Update your status </p>
        </div>

        <select id="statusSelect" onchange="updateStatus(event)" class="status-select">
            <option value="Undefined" <%= user?.status?.current_state === 'Undefined' ? 'selected' : '' %>>Undefined</option>
            <option value="OK" <%= user?.status?.current_state === 'OK' ? 'selected' : '' %>>OK</option>
            <option value="Emergency" <%= user?.status?.current_state === 'Emergency' ? 'selected' : '' %>>Emergency</option>
            <option value="Help" <%= user?.status?.current_state === 'Help' ? 'selected' : '' %>>Help</option>
        </select>

        
    </div>

      <script>
        function updateStatus(event){
            console.log("Status changed to: " + event.target.value);
           $.post("/setStatus", {status: event.target.value}, function(data){
               console.log("Status updated successfully.", data);
           });
        }
    </script>

   
    <script src="js/navbar.js"></script>
    <%- include('templates/footer') %>
</body>
</html>
