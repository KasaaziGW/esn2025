<!DOCTYPE html>
<html lang="en">
<head>
    <%- include("templates/head"); %>
    <script src="https://cdn.socket.io/4.8.1/socket.io.min.js" crossorigin="anonymous"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <style>
        /* -------------------- Chat Layout -------------------- */
        .wrapper{
            display: flex;
            padding-bottom: 50px;
            justify-content: space-evenly;
            width: 100%;
            padding-left: 1%;
             padding-right: 1%;
            overflow-y: auto;
            align-items: flex-start!important;
             gap: 2rem;
            flex-direction: row!important;
        }
        .users{
            max-width:  30%;
            margin-right: 2rem;
            flex-shrink: 0;
            overflow-y: auto!important;
            overflow-x: hidden;
            padding: 10px;
            min-height: 500px;
            max-height: 500px;
        }

        .chat-container {
            max-width: 70%;
            /* margin: 2rem auto; */
            display: flex;
            flex-direction: column;
            background: white;
            border-radius: 15px;
            border: 1px solid #e5e7eb;
            overflow: hidden;
            margin: 0px!important;
            height: 100vh; /* ensures input stays visible */
        }
        .chat-messages {
            flex: 1;
            padding: 0.5rem;
            overflow-y: auto;
            background: #f8fafc;
            min-height: 400px;
            max-height: 400px;
        }
        .chat-input-container {
            padding: 1rem 1.5rem;
            background: white;
            flex-shrink: 0;
        }
        .input-group {
            display: flex;
            gap: 1rem;
            align-items: flex-end;
        }
        .message-input {
            flex: 1;
            padding: 1rem 1.25rem;
            border: 2px solid #e5e7eb;
            border-radius: 25px;
            font-size: 1rem;
            background: #f8fafc;
            resize: none;
        }
        .send-button {
            padding: 1rem 1.5rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 25px;
            cursor: pointer;
            min-height: 50px;
        }
        .send-button:hover { transform: translateY(-2px); box-shadow: 0 4px 15px rgba(102,126,234,0.4); }

        /* -------------------- Messages -------------------- */
        .message { margin-bottom: 1rem; display: flex; flex-direction: column; }
        .message.own { align-items: flex-end; }
        .message.other { align-items: flex-start; }
        .message-content { max-width: 70%; padding: 0.75rem 1rem; border-radius: 15px; word-wrap: break-word; }
        .message.own .message-content { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; }
        .message.other .message-content { background: white; border: 1px solid #e5e7eb; color: #1f2937; }
        .message-header { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem; }
        .message-sender { font-weight: 600; font-size: 0.85rem; }
        .message-time { font-size: 0.75rem; color: rgba(0,0,0,0.65); }

            
        .user-card {
            background: white;
            border-radius: 15px;
            padding: 0.2rem;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            border: 1px solid #e5e7eb;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 10px;
            position: relative;
            margin-bottom: 10px;
        }
        
        .user-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 30px rgba(0,0,0,0.12);
        }
        
        .user-card.current-user {
            border: 2px solid #667eea;
            background: linear-gradient(135deg, rgba(102, 126, 234, 0.05) 0%, rgba(118, 75, 162, 0.05) 100%);
        }
        
        .user-avatar {
            width: 30px;
            height: 30px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.2rem;
            flex-shrink: 0;
        }
        
        .user-info {
            flex: 1;
        }
        
        .user-name {
            color: #1f2937;
            font-size: 1rem;
            font-weight: 600;
            margin: 0 0 0.25rem 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .user-name.current {
            color: #667eea;
        }
        
        .you-badge {
            background: #667eea;
            color: white;
            font-size: 0.7rem;
            padding: 0.2rem 0.5rem;
            border-radius: 10px;
            font-weight: 500;
        }
        
        .user-email {
            color: #6b7280;
            font-size: 0.9rem;
            margin: 0 0 0.5rem 0;
        }
        
        .user-status {
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            display: inline-block;
        }
        
        .status-dot.online {
            background: #10b981;
            box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.2);
        }
        
        .status-dot.offline {
            background: #9ca3af;
        }
        
        .status-text {
            font-size: 0.85rem;
            font-weight: 500;
        }
        
        .status-text.online {
            color: #10b981;
        }
        
        .status-text.offline {
            color: #9ca3af;
        }
    </style>
</head>
<body>
    <%- include('templates/navbar') %>
    <div class="wrapper">
        
    <div class="users">
        <% users.forEach(function(u) { %>
        <div class="user-card <%= u.email === user.email ? 'current-user' : '' %>">
            <div class="user-avatar">
                <i class="fas fa-user"></i>
            </div>
            <div class="user-info">
                <h4 class="user-name <%= u.email === user.email ? 'current' : '' %>">
                    <%= u.fullname %>
                    <% if (u.email === user.email) { %>
                        <span class="you-badge">You</span>
                    <% } %>
                </h4>
                <p class="user-email"><%= u.email %></p>
                <div class="user-status">
                    <span class="status-dot <%= u.online ? 'online' : 'offline' %>"></span>
                    <span class="status-text <%= u.online ? 'online' : 'offline' %>">
                        <%= u.online ? 'Online' : 'Offline' %>
                    </span>
                    <span class="status-text <%= u?.status?.current_state || 'undefined' %>">
                            <%- getStatusBadge(u?.status?.current_state || 'undefined') %>
                    </span>
                </div>
            </div>
            
        </div>
    <% }) %>
    </div>

    <div class="chat-container">
        <div id="chat-box" class="chat-messages"></div>

        <div class="chat-input-container">
            <form id="chat-form" class="chat-form">
                <input type="hidden" id="current-user-email" value="<%= user.email %>">
                <input type="hidden" id="receiver-email" value="<%= receiverEmail %>">

                <div class="input-group">
                    <input type="text" id="message-input" class="message-input" placeholder="Type your message..." required autocomplete="off">
                    <button type="submit" class="send-button" id="sendButton">
                        <i class="fas fa-paper-plane"></i> Send
                    </button>
                </div>
            </form>
        </div>
    </div>
    </div>

    <script>
        const socket = io();
        const chatBox = $("#chat-box");
        const currentUserEmail = $("#current-user-email").val();
        const receiverEmail = $("#receiver-email").val();
        const messageInput = $("#message-input");
        const chatForm = $("#chat-form");

        function escapeHtml(str) { if (!str) return ""; return String(str).replace(/[&<>"']/g, m => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[m]); }
        function getCurrentTime() {
            const d = new Date();
            const pad = n => n < 10 ? '0'+n : n;
            const date = [pad(d.getDate()), pad(d.getMonth()+1), d.getFullYear()].join("-");
            const time = [pad(d.getHours()), pad(d.getMinutes()), pad(d.getSeconds())].join(":");
            const ampm = d.getHours() >= 12 ? "PM" : "AM";
            return `${date} ${time} ${ampm}`;
        }
        function scrollToBottom() { chatBox.scrollTop(chatBox.prop("scrollHeight")); }

        function appendMessage(msg) {
            const isOwn = msg.sender === currentUserEmail;
            const html = `
                <div class="message ${isOwn ? 'own' : 'other'}">
                    <div class="message-header">
                        <span class="message-sender">${isOwn ? 'You' : escapeHtml(msg.sender)}</span>
                        <span class="message-time">${msg.sentTime}</span>
                    </div>
                    <div class="message-content">
                        <div class="message-text">${escapeHtml(msg.message)}</div>
                    </div>
                </div>`;
            chatBox.append(html);
            scrollToBottom();
        }

        // Fetch previous messages
        function fetchPrivateMessages() {
            $.get(`/fetchPrivateMessages?sender=${encodeURIComponent(currentUserEmail)}&receiver=${encodeURIComponent(receiverEmail)}`)
            .done(data => { chatBox.empty(); data.forEach(appendMessage); })
            .fail(() => console.error("Failed to fetch private messages"));
        }
        fetchPrivateMessages();

        // Send message
        chatForm.on("submit", function(e){
            e.preventDefault(); // prevent page reload
            const text = messageInput.val().trim();
            if(!text) return;

            const msg = {
                sender: currentUserEmail,
                receiver: receiverEmail,
                message: text,
                sentTime: getCurrentTime()
            };

            // append immediately
            appendMessage(msg);
            messageInput.val("");

            // Save to server
            $.post("/sendPrivateMessage", msg).fail(() => console.error("Failed to send private message"));

            // Emit via socket
            socket.emit("sendPrivateMessage", msg);
        });

        // Join private room
        socket.emit("joinPrivate", { sender: currentUserEmail, receiver: receiverEmail });

        socket.on("privateMessage", msg => {
            // Only show messages not sent by current user (avoids duplicates)
            if(msg.sender !== currentUserEmail &&
               ((msg.sender === receiverEmail && msg.receiver === currentUserEmail) ||
                (msg.sender === currentUserEmail && msg.receiver === receiverEmail))) {
                appendMessage(msg);
            }
        });
    </script>

    <script src="js/navbar.js"></script>
    <%- include('templates/footer') %>
</body>
</html>
