<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('templates/head') %>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        body {
            margin: 0;
            padding: 0;
            background: #f3f3f3;
        }
        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #fff;
            border-bottom: 2px solid #c00;
            padding: 0.5em 2em 0.5em 1em;
        }
        .topbar .logo {
            font-weight: bold;
            color: #0074c2;
            font-size: 1.3em;
        }
        .topbar .welcome {
            font-weight: bold;
            font-size: 1.2em;
        }
        .topbar .logout {
            font-weight: bold;
            color: #0a3d62;
            text-decoration: underline;
            font-size: 1.1em;
        }
        .container {
            display: flex;
            height: calc(100vh - 56px);
            margin-left: 320px;
        }
        .sidebar {
            background: #c2e6fa;
            width: 320px;
            min-width: 220px;
            max-width: 320px;
            transition: width 0.3s;
            font-size: 1.2em;
            padding-top: 1em;
            padding-left: 0;
            position: fixed;
            top: 56px;
            left: 0;
            height: calc(100vh - 56px);
            z-index: 10;
        }
        .sidebar.collapsed {
            width: 60px;
            min-width: 60px;
            max-width: 60px;
            overflow: hidden;
        }
        .sidebar .collapse-btn {
            background: none;
            border: none;
            font-size: 1.5em;
            color: #0074c2;
            cursor: pointer;
            margin-bottom: 1em;
            margin-left: 16px;
        }
        .sidebar ul {
            list-style: none;
            padding: 0;
        }
        .sidebar a {
            text-decoration: none;
            color: #0074c2;
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: bold;
            padding-left: 16px;
            margin-bottom: 1em;
            transition: background 0.2s, color 0.2s;
            border-radius: 5px;
        }
        .sidebar a.active {
            background: #ccc;
            color: #222;
        }
        .sidebar a:hover {
            background: #b3d8f5;
            color: #0a3d62;
        }
        .sidebar .submenu {
            margin-left: 32px;
            font-weight: normal;
            font-size: 0.95em;
        }
        .sidebar.collapsed span.menu-text {
            display: none;
        }
        .sidebar .fa {
            min-width: 24px;
            text-align: center;
        }
        .main {
            flex: 1;
            background: #f3f3f3;
            padding: 2em;
        }
        .user-list {
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.07);
            padding: 2em;
            max-width: 600px;
            margin: 0 auto;
        }
        .user-item {
            display: flex;
            align-items: center;
            gap: 1em;
            padding: 0.7em 0;
            border-bottom: 1px solid #eee;
        }
        .user-dot {
            width: 14px;
            height: 14px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 8px;
        }
        .user-dot.online {
            background: #2ecc40;
        }
        .user-dot.offline {
            background: #aaa;
        }
        .user-name {
            font-weight: normal;
        }
        .user-name.current {
            font-weight: bold;
        }
    </style>
</head>
<body>
    <div class="topbar">
        <span class="logo">Emergency Social Network [ESN]</span>
        <span class="welcome">Welcome, <%= user.fullname %></span>
        <a href="/logout" class="logout">Logout</a>
    </div>
    <div class="container">
        <nav class="sidebar" id="sidebar">
            <button class="collapse-btn" onclick="toggleSidebar()"><i class="fa fa-bars"></i></button>
            <ul style="padding:0;">
                <li>
                  <a href="/dashboard"><i class="fa fa-tachometer-alt"></i> <span class="menu-text">Dashboard</span></a>
                </li>
                <li>
                  <a href="/directory" class="active"><i class="fa fa-address-book"></i> <span class="menu-text">ESN Directory</span></a>
                </li>
                <li>
                  <a href="#"><i class="fa fa-comments"></i> <span class="menu-text">Chat</span></a>
                  <ul class="submenu">
                    <li><a href="/chat/public"><i class="fa fa-globe"></i> <span class="menu-text">Public</span></a></li>
                    <li><a href="/chat/private"><i class="fa fa-user-secret"></i> <span class="menu-text">Private</span></a></li>
                  </ul>
                </li>
                <li>
                  <a href="/share-status"><i class="fa fa-share-square"></i> <span class="menu-text">Share Status</span></a>
                </li>
            </ul>
        </nav>
        <main class="main">
            <div class="user-list">
                <h3>ESN Directory</h3>
                <% users.forEach(function(u) { %>
                    <div class="user-item">
                        <span class="user-dot <%= u.online ? 'online' : 'offline' %>"></span>
                        <span class="user-name <%= u.email === user.email ? 'current' : '' %>"><%= u.fullname %></span>
                        <span style="font-size:0.9em; color:#888;">&lt;<%= u.email %>&gt;</span>
                    </div>
                <% }) %>
            </div>
        </main>
    </div>
    <script>
        function toggleSidebar() {
            var sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('collapsed');
            var container = document.querySelector('.container');
            if (sidebar.classList.contains('collapsed')) {
                container.style.marginLeft = '60px';
            } else {
                container.style.marginLeft = '320px';
            }
        }
    </script>
    <%- include('templates/footer') %>
</body>
</html>
